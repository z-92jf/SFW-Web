---
// ============================================================
// 下载源选择弹窗（全站共用，只在 BaseLayout 里渲染一次）
// ============================================================
//
// 为什么要有这个弹窗：
//   GitHub 在国内时通时不通，直接点「立即下载」经常卡死或者 404。
//   所以点按钮时先让用户选一条路：GitHub 官方仓库，或者第三方托管。
//
// 怎么工作：
//   1. 站点上任何带 data-dl-version 的 [a 标签] 被点击时，这段脚本拦下
//      （阻止默认跳转），读取它的 href 和版本号，弹出窗口
//   2. 用户在弹窗里选通道，这时候才真正跳转，并给统计接口记一次数
//   3. 没开 JS 的话拦不住，链接照原样直接下载 —— 这是有意保留的降级
//
// ★ 要改的地方
//   - 通道的文案：直接在下面 markup 里改
//   - 镜像域名：src/data/site.ts 的 downloadMirror
//   - MD5 值：src/data/site.ts 的 releases 数组，每个文件一个 md5 字段
// ============================================================

import { site, links, downloadMirror, releases } from '../data/site';

// 最新版的安装包文件名（从下载直链末尾取），用来拼镜像地址兜底
const latestExe = decodeURIComponent(links.download.split('/').pop() || '');

// 镜像站还没部署时（downloadMirror 是空串），Cloudflare 那一路先禁用
const mirrorReady = downloadMirror.trim() !== '';

// 镜像站上放了【所有版本】的全部文件，所以历史版本的 Cloudflare 通道也能用。
// 只有某个版本缺文件（assets 为空）时才禁用。

/** 判断某个文件是安装程序还是免安装包：按扩展名，不按 label */
const isZip = (file: string) => /\.zip$/i.test(file);
---

{/* data-mirror 是给下面脚本读的：
    服务端变量进不了脚本块（那是一个独立模块），只能这样传过去。
    ⚠ 下面注释和样式里都别写出带尖括号的 script / style 字样，
      否则静态检查脚本会误判成真的标签（已经踩过一次） */}
<div class="dl-overlay" id="dlOverlay" data-mirror={downloadMirror} hidden>
	<div
		class="dl-dialog"
		role="dialog"
		aria-modal="true"
		aria-labelledby="dlTitle"
		aria-describedby="dlSub"
	>
		<!-- 关闭按钮：右上角 -->
		<button class="dl-close" id="dlClose" type="button" aria-label="关闭">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
				<path d="M18 6 6 18M6 6l12 12"></path>
			</svg>
		</button>

		<header class="dl-head">
			<h2 class="dl-title" id="dlTitle">请选择合适的下载地址</h2>
			<p class="dl-sub" id="dlSub">
				当前版本 v<span id="dlVersion">{site.version}</span> ·
				<span id="dlKind">{latestExe.endsWith('.zip') ? '免安装包' : '安装程序'}</span>
			</p>
		</header>

		<!-- 两条通道：横向并排，窄屏自动变一列 -->
		<div class="dl-channels">
			<!-- ① GitHub 官方仓库。href 由脚本按实际点击的按钮填，历史版本也能用 -->
			<a
				class="dl-card"
				id="dlGithub"
				href={links.download}
				target="_blank"
				rel="noopener"
			>
				<span class="dl-card-head">
					<span class="dl-card-name">GitHub Release</span>
					<svg class="dl-card-icon" width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
						<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
					</svg>
				</span>
				<span class="dl-card-desc">
					从 Github 官方仓库拉取下载，国内访问可能较慢。
				</span>
			</a>

			<!-- ② 第三方托管。地址由脚本拼：镜像域名 + 文件名 -->
			<a
				class="dl-card"
				id="dlCloudflare"
				href="#"
				target="_blank"
				rel="noopener"
				aria-disabled={mirrorReady ? 'false' : 'true'}
			>
				<span class="dl-card-head">
					<span class="dl-card-name">Cloudflare</span>
					<svg class="dl-card-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"></path>
					</svg>
				</span>
				<span class="dl-card-desc">
					从第三方托管下载，国内访问更稳定。
				</span>
			</a>
		</div>

		<!-- 文件校验值：默认收起，交互跟 /top 的常见问题一致 -->
		<details class="dl-md5" id="dlMd5">
			<summary>
				<span>文件MD5值</span>
				<svg class="dl-md5-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="m6 9 6 6 6-6"></path>
				</svg>
			</summary>
			<div class="dl-md5-body">
				{/*
					每个版本预渲染一段，脚本只负责切换 hidden。
					⚠ 不能让 JS 动态创建这些 <p>：Astro 的作用域样式靠
					  data-astro-cid-* 属性匹配，JS 造出来的元素没有这个属性，
					  样式会整个失效（字号、间距、code 底色全丢）。
				*/}
				{
					releases.map((r) => (
						<div class="dl-md5-set" data-md5-version={r.version} hidden>
							{r.assets.map((a) => (
								<p class="dl-md5-row">
									{isZip(a.file) ? '免安装包MD5值：' : '安装程序MD5值：'}
									<code>{a.md5 || '待补充'}</code>
								</p>
							))}
							<p class="dl-md5-tip">
								您可以自行在下载后核对文件MD5值以确保文件没有损坏。
							</p>
						</div>
					))
				}
			</div>
		</details>
	</div>
</div>

<style>
	/* ------------------------------------------------------------
	   一、遮罩
	   混一层莫兰迪蓝的暗色，比纯黑柔和，也跟站点的蓝调呼应
	   ------------------------------------------------------------ */
	.dl-overlay {
		/* 莫兰迪蓝：低饱和、加了灰度的蓝，不刺眼 */
		--dl-accent: #6d8ba3;
		--dl-accent-strong: #4a6478;
		--dl-accent-soft: #eef3f7;
		--dl-accent-line: #cfdce6;

		position: fixed;
		inset: 0;
		z-index: 200;
		display: grid;
		place-items: center;
		padding: 24px;
		background: rgba(40, 54, 66, 0.52);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		animation: dlFade 0.16s ease;
	}

	/* [hidden] 要显式压回 none：上面那句 display:grid 会盖掉浏览器的默认规则 */
	.dl-overlay[hidden] {
		display: none;
	}

	@keyframes dlFade {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	/* ------------------------------------------------------------
	   二、窗口本体
	   ------------------------------------------------------------ */
	.dl-dialog {
		position: relative;
		width: min(700px, 100%);
		/* global.css 里有 * { box-sizing: border-box }，本来不需要写这句。
		   这里冗余一遍是为了组件自包含：万一以后有人改了全局重置，
		   弹窗宽度不会悄悄变成「700 + 左右 padding」。 */
		box-sizing: border-box;
		max-height: calc(100vh - 48px);
		overflow-y: auto;
		padding: 30px 32px 26px;
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: 20px;
		box-shadow: 0 24px 64px rgba(32, 46, 58, 0.26);
		animation: dlRise 0.2s cubic-bezier(0.2, 0.8, 0.3, 1);
	}

	@keyframes dlRise {
		from {
			opacity: 0;
			transform: translateY(12px) scale(0.985);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	.dl-close {
		position: absolute;
		top: 16px;
		right: 16px;
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		padding: 0;
		border: 0;
		border-radius: 9px;
		background: transparent;
		color: var(--text-faint);
		cursor: pointer;
		transition: color 0.15s, background 0.15s;
	}

	.dl-close:hover {
		color: var(--text);
		background: var(--dl-accent-soft);
	}

	.dl-close:focus-visible {
		outline: 2px solid var(--dl-accent);
		outline-offset: 2px;
	}

	/* ------------------------------------------------------------
	   三、标题
	   ------------------------------------------------------------ */
	.dl-head {
		margin-bottom: 22px;
		padding-right: 40px;
	}

	.dl-title {
		margin: 0 0 6px;
		font-size: 1.32rem;
		font-weight: 600;
		line-height: 1.35;
		color: var(--text);
		letter-spacing: 0.01em;
	}

	.dl-sub {
		margin: 0;
		font-size: 0.88rem;
		color: var(--text-muted);
	}

	/* ------------------------------------------------------------
	   四、两条通道（横向并排）
	   ------------------------------------------------------------ */
	.dl-channels {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 14px;
	}

	.dl-card {
		display: block;
		padding: 18px 18px 16px;
		background: var(--dl-accent-soft);
		/* 左边缘一道莫兰迪蓝，替代整块上色，视觉更轻 */
		border: 1px solid var(--dl-accent-line);
		border-radius: 14px;
		color: var(--text);
		text-decoration: none;
		transition: border-color 0.16s, box-shadow 0.16s, transform 0.16s, background 0.16s;
	}

	.dl-card:hover {
		background: var(--card);
		border-color: var(--dl-accent);
		box-shadow: 0 8px 20px rgba(74, 100, 120, 0.14);
		transform: translateY(-2px);
	}

	.dl-card:focus-visible {
		outline: 2px solid var(--dl-accent);
		outline-offset: 2px;
	}

	.dl-card-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
		margin-bottom: 10px;
	}

	.dl-card-name {
		font-size: 1.02rem;
		font-weight: 600;
		color: var(--dl-accent-strong);
		letter-spacing: 0.01em;
	}

	.dl-card-icon {
		flex-shrink: 0;
		color: var(--dl-accent);
		transition: color 0.16s, transform 0.16s;
	}

	.dl-card:hover .dl-card-icon {
		color: var(--dl-accent-strong);
		transform: translateY(2px);
	}

	.dl-card-desc {
		display: block;
		font-size: 0.86rem;
		line-height: 1.6;
		color: var(--text-muted);
	}

	/* 镜像还没部署：整体压暗、不能点，并在名字后面挂个「即将上线」 */
	.dl-card[aria-disabled='true'] {
		opacity: 0.55;
		cursor: not-allowed;
		pointer-events: none;
	}

	.dl-card[aria-disabled='true'] .dl-card-name::after {
		content: '即将上线';
		margin-left: 8px;
		padding: 2px 7px;
		border: 1px solid var(--dl-accent-line);
		border-radius: 999px;
		background: var(--card);
		color: var(--text-faint);
		font-size: 0.7rem;
		font-weight: 500;
		vertical-align: 2px;
	}

	/* ------------------------------------------------------------
	   五、文件 MD5（可折叠，跟 /top 的常见问题同一套交互）
	   ------------------------------------------------------------ */
	.dl-md5 {
		margin-top: 20px;
		background: transparent;
		border: 1px solid var(--border);
		border-radius: 12px;
		transition: border-color 0.16s;
	}

	.dl-md5:hover {
		border-color: var(--border-strong);
	}

	.dl-md5 summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 13px 18px;
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--text-muted);
		cursor: pointer;
		/* 去掉系统默认的小三角，换成自己那个会被旋转的箭头 */
		list-style: none;
	}

	.dl-md5 summary::-webkit-details-marker {
		display: none;
	}

	.dl-md5 summary:hover {
		color: var(--text);
	}

	.dl-md5 summary:focus-visible {
		outline: 2px solid var(--dl-accent);
		outline-offset: -2px;
		border-radius: 12px;
	}

	.dl-md5-arrow {
		flex-shrink: 0;
		color: var(--text-faint);
		transition: transform 0.2s ease;
	}

	.dl-md5[open] .dl-md5-arrow {
		transform: rotate(180deg);
	}

	.dl-md5-body {
		padding: 2px 18px 16px;
		border-top: 1px solid var(--border);
	}

	.dl-md5-row {
		margin: 12px 0 0;
		font-size: 0.86rem;
		color: var(--text-muted);
		/* 版本号那种长串不能折行，否则复制出来会带空格 */
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 6px;
	}

	.dl-md5-row code {
		display: inline-block;
		padding: 3px 8px;
		background: var(--dl-accent-soft);
		border: 1px solid var(--dl-accent-line);
		border-radius: 6px;
		color: var(--dl-accent-strong);
		font-family: var(--font-mono, ui-monospace, SFMono-Regular, Consolas, monospace);
		font-size: 0.82rem;
		letter-spacing: 0.02em;
		word-break: break-all;
		user-select: all;
	}

	.dl-md5-tip {
		margin: 14px 0 0;
		font-size: 0.8rem;
		line-height: 1.65;
		color: var(--text-faint);
	}

	/* ------------------------------------------------------------
	   六、窄屏：两条通道改成上下排
	   ------------------------------------------------------------ */
	@media (max-width: 560px) {
		.dl-overlay {
			padding: 16px;
			/* 手机上从底部升起更顺手，也更接近原生弹层的习惯 */
			place-items: end center;
		}

		.dl-dialog {
			width: 100%;
			padding: 24px 20px 20px;
			border-radius: 18px;
		}

		.dl-title {
			font-size: 1.15rem;
		}

		.dl-channels {
			grid-template-columns: 1fr;
		}

		.dl-card {
			padding: 15px 16px 14px;
		}
	}

	/* ------------------------------------------------------------
	   七、深色模式
	   莫兰迪蓝在深底上要提亮，否则糊成一片
	   ------------------------------------------------------------ */
	:global(:root[data-theme='dark']) .dl-overlay {
		--dl-accent: #8fadc4;
		--dl-accent-strong: #b4cbd9;
		--dl-accent-soft: #262f37;
		--dl-accent-line: #3a4854;

		background: rgba(10, 14, 18, 0.66);
	}

	/* 用户没手动切过、系统是深色时也一样（无 JS 时的兜底） */
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .dl-overlay {
			--dl-accent: #8fadc4;
			--dl-accent-strong: #b4cbd9;
			--dl-accent-soft: #262f37;
			--dl-accent-line: #3a4854;

			background: rgba(10, 14, 18, 0.66);
		}
	}

	/* 尊重系统的「减少动态效果」 */
	@media (prefers-reduced-motion: reduce) {
		.dl-overlay,
		.dl-dialog {
			animation: none;
		}

		.dl-card,
		.dl-card-icon,
		.dl-md5-arrow {
			transition: none;
		}
	}
</style>

<script>
	// ============================================================
	// 弹窗的开关与数据填充
	// ============================================================
	const overlay = document.getElementById('dlOverlay');

	if (overlay) {
		const dialog = overlay.querySelector('.dl-dialog');
		const closeBtn = document.getElementById('dlClose');
		const githubCard = document.getElementById('dlGithub');
		const cfCard = document.getElementById('dlCloudflare');
		const versionEl = document.getElementById('dlVersion');
		const kindEl = document.getElementById('dlKind');
		const md5Block = document.getElementById('dlMd5');

		// 由 Astro 写在 data-* 上的常量，不依赖任何运行时请求
		const MIRROR = overlay.dataset.mirror ?? '';

		let lastTrigger = null; // 记住是谁打开的，关闭后把焦点还给它
		let pendingVersion = '';

		/** 取这个链接要下载的文件名（直链最后一段，可能被 URL 编码过） */
		function fileNameOf(href: string): string {
			const tail = href.split('?')[0].split('/').pop() ?? '';
			try {
				return decodeURIComponent(tail);
			} catch {
				return tail;
			}
		}

		function open(link: HTMLAnchorElement) {
			const version = link.dataset.dlVersion ?? '';
			const href = link.getAttribute('href') ?? '';

			lastTrigger = link;
			pendingVersion = version;

			// ① GitHub 通道：直接用触发按钮原来的地址，所以历史版本也对
			githubCard.setAttribute('href', href);

			// ② Cloudflare 通道：镜像域名 + 同一个文件名
			//    镜像站上放了【所有版本】的文件，所以历史版本照样能用。
			//    取不到文件名（理论上不会）或者镜像还没部署时才禁用。
			const file = fileNameOf(href);
			if (MIRROR && file) {
				cfCard.setAttribute('href', MIRROR.replace(/\/+$/, '') + '/' + encodeURIComponent(file));
				cfCard.setAttribute('aria-disabled', 'false');
			} else {
				cfCard.setAttribute('href', '#');
				cfCard.setAttribute('aria-disabled', 'true');
			}

			// ③ MD5 区块：切换到这个版本对应的那一段
			//    所有版本都是预渲染好的，这里只改 hidden，不创建元素
			//    （动态创建的元素拿不到 Astro 的作用域样式属性）
			const md5Sets = md5Block.querySelectorAll<HTMLElement>('.dl-md5-set');
			let matched = false;
			md5Sets.forEach((el) => {
				const hit = el.dataset.md5Version === version;
				el.hidden = !hit;
				if (hit) matched = true;
			});
			// 版本对不上（比如按钮写错版本号）时整块藏起来，别显示空壳
			md5Block.hidden = !matched;

			versionEl.textContent = version || '未知';
			// 免安装包是压缩包，说清楚，免得有人拿到 zip 还在找 exe
			kindEl.textContent = /\.zip$/i.test(file) ? '免安装包' : '安装程序';

			overlay.hidden = false;
			// 弹窗开着的时候别让底下的页面跟着滚
			document.body.style.overflow = 'hidden';
			closeBtn.focus();
		}

		function close() {
			if (overlay.hidden) return;

			overlay.hidden = true;
			document.body.style.overflow = '';

			// 折叠状态收回去，下次打开是一样的初始样子
			const md5 = document.getElementById('dlMd5');
			if (md5 instanceof HTMLDetailsElement) md5.open = false;

			// 焦点还给刚才那个按钮，键盘用户不会「丢失位置」
			lastTrigger?.focus();
		}

		// ---- 拦截站内所有带 data-dl-version 的下载按钮 ----
		// 用 capture 阶段：比其它任何 click 处理器都早，也拦得住
		// 那些自己 preventDefault 的扩展
		document.addEventListener(
			'click',
			(event) => {
				const target = event.target;
				if (!(target instanceof Element)) return;

				const link = target.closest('a[data-dl-version]');
				if (!(link instanceof HTMLAnchorElement)) return;

				event.preventDefault();
				open(link);
			},
			{ capture: true }
		);

		// ---- 关闭的三种方式 ----
		closeBtn.addEventListener('click', close);
		overlay.addEventListener('click', (event) => {
			// 只有点在遮罩本身（而不是窗口内部）才关
			if (event.target === overlay) close();
		});
		document.addEventListener('keydown', (event) => {
			if (overlay.hidden) return;

			if (event.key === 'Escape') {
				close();
				return;
			}

			// 焦点别跑出弹窗：Tab 到最后一个再按就回到第一个
			if (event.key === 'Tab') {
				const focusable = Array.from(
					dialog.querySelectorAll<HTMLElement>('a[href], button, summary, [tabindex]:not([tabindex="-1"])')
				).filter((el) => el.offsetParent !== null);

				if (focusable.length === 0) return;
				const first = focusable[0];
				const last = focusable[focusable.length - 1];

				if (!event.shiftKey && document.activeElement === last) {
					event.preventDefault();
					first.focus();
				} else if (event.shiftKey && document.activeElement === first) {
					event.preventDefault();
					last.focus();
				}
			}
		});

		// ---- 真正选好通道、开始下载时才记一次数 ----
		// 放在这里而不是点按钮时，是为了「打开弹窗又关掉」不计入统计
		//
		// ⚠ 这个函数由 BaseLayout 末尾的脚本挂到 window 上，而那个脚本
		//   排在弹窗脚本【之后】执行。所以不能在这里提前读一次存下来，
		//   必须在每次点击时现取，否则拿到的永远是 undefined。
		const onChannelClick = () => {
			const reportHit = Reflect.get(window, '__sfwDlHit');
			if (typeof reportHit === 'function') reportHit(pendingVersion);
		};

		githubCard.addEventListener('click', onChannelClick);
		cfCard.addEventListener('click', (event) => {
			if (cfCard.getAttribute('aria-disabled') === 'true') {
				event.preventDefault();
				return;
			}
			onChannelClick();
		});
	}
</script>
