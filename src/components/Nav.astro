---
// ============================================================
//  顶部导航栏
//
//  ★ 要改菜单项 → 改 src/data/site.ts 里的 navItems
//  ★ 要改外观   → 改本文件底部 <style> 里的样式
// ============================================================

import { site, navItems } from '../data/site';

// 当前访问的路径，用来给「当前所在页」的菜单项加高亮
const currentPath = Astro.url.pathname;
---

<header class="site-nav">
	<div class="container nav-inner">
		<!-- 左侧：站点标识。点击回到欢迎页（而不是直接回首页） -->
		<a href="/" class="brand">
			<span class="brand-mark">SFW</span>
			<span class="brand-text">{site.title}</span>
		</a>

		<!-- 移动端的汉堡按钮。桌面端被 CSS 隐藏 -->
		<button class="nav-toggle" type="button" aria-label="打开导航菜单" aria-expanded="false" id="navToggle">
			<span></span><span></span><span></span>
		</button>

		<!-- 右侧：菜单 + 主题切换 -->
		<nav class="nav-links" id="navLinks">
			{
				navItems.map((item) => {
					// 判断是否是当前页：/download 和 /download/ 都算
					const isActive =
						currentPath === item.href || currentPath === item.href + '/';
					return (
						<a href={item.href} class:list={['nav-link', { active: isActive }]}>
							{item.text}
						</a>
					);
				})
			}

			<!-- 深浅色切换按钮 -->
			<button class="theme-toggle" type="button" id="themeToggle" aria-label="切换深浅色模式" title="切换深浅色模式">
				<svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<circle cx="12" cy="12" r="4"></circle>
					<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
				</svg>
				<svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
				</svg>
			</button>
		</nav>
	</div>
</header>

<script>
	// ============================================================
	// 导航栏交互
	// 这段脚本会被 Astro 自动打包，只在浏览器里执行，不影响构建。
	// ============================================================

	// ---- 1. 移动端菜单开关 ----
	const toggle = document.getElementById('navToggle');
	const links = document.getElementById('navLinks');

	toggle?.addEventListener('click', () => {
		const isOpen = links?.classList.toggle('open');
		toggle.setAttribute('aria-expanded', String(!!isOpen));
	});

	// ---- 2. 深浅色切换 ----
	const themeBtn = document.getElementById('themeToggle');

	themeBtn?.addEventListener('click', () => {
		const root = document.documentElement;
		// 先看当前实际是深还是浅
		const isDark = root.getAttribute('data-theme')
			? root.getAttribute('data-theme') === 'dark'
			: window.matchMedia('(prefers-color-scheme: dark)').matches;

		const next = isDark ? 'light' : 'dark';
		root.setAttribute('data-theme', next);
		try {
			localStorage.setItem('sfw-theme', next);
		} catch (e) {
			/* 存不了就算了，不影响本次切换 */
		}
	});
</script>

<style>
	.site-nav {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--bg) 88%, transparent);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}

	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 64px;
	}

	/* ---- 左侧标识 ---- */
	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		color: var(--text);
		text-decoration: none;
		font-weight: 600;
	}

	.brand:hover {
		text-decoration: none;
	}

	.brand-mark {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border-radius: 9px;
		background: var(--brand);
		color: #fff;
		font-size: 0.8rem;
		letter-spacing: 0.02em;
	}

	.brand-text {
		font-size: 1rem;
	}

	/* ---- 右侧菜单 ---- */
	.nav-links {
		display: flex;
		align-items: center;
		gap: 4px;
	}

	.nav-link {
		padding: 8px 14px;
		border-radius: 8px;
		color: var(--text-muted);
		font-size: 0.95rem;
		text-decoration: none;
		transition: color 0.15s, background 0.15s;
	}

	.nav-link:hover {
		color: var(--text);
		background: var(--bg-soft);
		text-decoration: none;
	}

	/* 当前所在页高亮 */
	.nav-link.active {
		color: var(--brand);
		background: color-mix(in srgb, var(--brand) 10%, transparent);
	}

	/* ---- 主题切换按钮 ---- */
	.theme-toggle {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		margin-left: 8px;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: transparent;
		color: var(--text-muted);
		cursor: pointer;
		transition: color 0.15s, border-color 0.15s;
	}

	.theme-toggle:hover {
		color: var(--brand);
		border-color: var(--brand);
	}

	/* 太阳/月亮图标只显示其中一个：
	   深色模式显示太阳（提示点了会变亮），浅色模式显示月亮 */
	:global(:root[data-theme='dark']) .icon-moon,
	:global(:root[data-theme='light']) .icon-sun {
		display: none;
	}

	:global(:root[data-theme='dark']) .icon-sun,
	:global(:root[data-theme='light']) .icon-moon {
		display: block;
	}

	/* 用户没手动切换过时，跟随系统 */
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .icon-moon {
			display: none;
		}
		:global(:root:not([data-theme='light'])) .icon-sun {
			display: block;
		}
	}

	/* ---- 汉堡按钮（默认隐藏，窄屏才出现） ---- */
	.nav-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 40px;
		height: 40px;
		padding: 0 9px;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: transparent;
		cursor: pointer;
	}

	.nav-toggle span {
		display: block;
		height: 2px;
		background: var(--text);
		border-radius: 1px;
	}

	/* ---- 窄屏适配：菜单收进下拉面板 ---- */
	@media (max-width: 720px) {
		.nav-toggle {
			display: flex;
		}

		.brand-text {
			display: none;
		}

		.nav-links {
			position: absolute;
			top: 64px;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: 8px 16px 16px;
			background: var(--bg);
			border-bottom: 1px solid var(--border);
			/* 默认收起，加 .open 才展开 */
			display: none;
		}

		.nav-links.open {
			display: flex;
		}

		.nav-link {
			padding: 12px 14px;
		}

		.theme-toggle {
			margin: 8px 0 0;
			width: 100%;
		}
	}
</style>
