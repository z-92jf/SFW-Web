---
// ============================================================
//  顶部导航栏
//
//  ★ 要改菜单项 → 改 src/data/site.ts 里的 navItems
//  ★ 要改外观   → 改本文件底部 <style> 里的样式
// ============================================================

import { site, navItems, links } from '../data/site';

// 当前访问的路径，用来给「当前所在页」的菜单项加高亮
const currentPath = Astro.url.pathname;
---

<header class="site-nav">
	<div class="container nav-inner">
		<!-- ① 左：站点标识。点击回到欢迎页（而不是直接回首页） -->
		<a href="/" class="brand">
			{/* 图标文件是 public/logo.png（256×256）。
			   ★ 想换图标：直接覆盖这个文件即可，不用改代码。 */}
			<img class="brand-mark" src="/logo.png" alt="" width="34" height="34" />
			<span class="brand-text">{site.title}</span>
		</a>

		<!-- ② 中：导航菜单。
		     这里【只放菜单项】，不放其它东西 —— 这样它才能严格居中于整个导航栏。
		     （深浅色切换已挪到右侧那一组，否则它会把菜单整体往左挤一截） -->
		<nav class="nav-links" id="navLinks">
			{
				navItems.map((item) => {
					// 判断是否是当前页：/download 和 /download/ 都算
					const isActive =
						currentPath === item.href || currentPath === item.href + '/';
					return (
						<a href={item.href} class:list={['nav-link', { active: isActive }]}>
							{item.text}
						</a>
					);
				})
			}
		</nav>

		<!-- ③ 右：立即下载 → GitHub → 深浅色切换 → 移动端汉堡按钮。
		     顺序按「动作在最前、工具在后面」排：
		     立即下载（最常用的动作）→ GitHub（外链）→ 主题切换（设置类，放最后）。
		     ★ 想换顺序：直接把下面三个元素上下挪动即可，CSS 不用动。 -->
		<div class="nav-right">
			<a
				class="btn btn-primary btn-sm nav-cta"
				href={links.download}
				target="_blank"
				rel="noopener"
			>
				立即下载
			</a>

			<!-- GitHub 仓库。图标是内嵌的 SVG，不依赖任何图标库 -->
			<a
				class="nav-icon-btn"
				href={links.github}
				target="_blank"
				rel="noopener"
				aria-label="GitHub 仓库"
				title="GitHub 仓库"
			>
				<svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
					<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
				</svg>
			</a>

			<!-- 深浅色切换按钮 -->
			<button class="nav-icon-btn theme-toggle" type="button" id="themeToggle" aria-label="切换深浅色模式" title="切换深浅色模式">
				<svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<circle cx="12" cy="12" r="4"></circle>
					<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
				</svg>
				<svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
				</svg>
			</button>

			<!-- 移动端的汉堡按钮。桌面端被 CSS 隐藏 -->
			<button class="nav-toggle" type="button" aria-label="打开导航菜单" aria-expanded="false" id="navToggle">
				<span></span><span></span><span></span>
			</button>
		</div>
	</div>
</header>

<script>
	// ============================================================
	// 导航栏交互
	// 这段脚本会被 Astro 自动打包，只在浏览器里执行，不影响构建。
	// ============================================================

	// ---- 1. 移动端菜单开关 ----
	const toggle = document.getElementById('navToggle');
	const links = document.getElementById('navLinks');

	toggle?.addEventListener('click', () => {
		const isOpen = links?.classList.toggle('open');
		toggle.setAttribute('aria-expanded', String(!!isOpen));
	});

	// ---- 2. 深浅色切换 ----
	const themeBtn = document.getElementById('themeToggle');

	themeBtn?.addEventListener('click', () => {
		const root = document.documentElement;
		// 先看当前实际是深还是浅
		const isDark = root.getAttribute('data-theme')
			? root.getAttribute('data-theme') === 'dark'
			: window.matchMedia('(prefers-color-scheme: dark)').matches;

		const next = isDark ? 'light' : 'dark';
		root.setAttribute('data-theme', next);
		try {
			localStorage.setItem('sfw-theme', next);
		} catch (e) {
			/* 存不了就算了，不影响本次切换 */
		}
	});
</script>

<style>
	.site-nav {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--bg) 88%, transparent);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);

		/* ★ 要改：导航栏左右两端的留白。
		   页面正文用的是全局的 .container（最大宽度 1100px），那个宽度对正文
		   正合适，但导航栏套进去以后两端会各空出一大块，看着很散。
		   这里单独给导航栏一个更宽的上限 —— 数字越大，左边的产品名和右边的
		   按钮就越贴近窗口两边。设成 100% 就等于完全贴边（由 24px 内边距兜底）。 */
		--nav-width: 1440px;
	}

	/* 三栏布局：左（标识） / 中（菜单） / 右（下载按钮）。
	   用 grid 的「1fr auto 1fr」——中间那列宽度由内容决定、两侧各占剩余空间，
	   菜单就严格居中了。用 flex 是做不到真正居中的。

	   选择器写成「.site-nav .nav-inner」两级，是为了盖掉全局 .container 的
	   1100px 上限（单写 .nav-inner 优先级不够，在部分 Astro 版本下会被反向压制）。 */
	.site-nav .nav-inner {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 16px;
		height: 64px;
		max-width: var(--nav-width);
		/* 窗口比 --nav-width 还窄时，靠这个内边距兜底，别让内容贴到边上。
		   比正文的 24px 稍大一点，导航栏看起来更稳。 */
		padding: 0 32px;
	}

	/* ---- 左侧标识 ---- */
	.brand {
		/* 第一格，靠左 */
		justify-self: start;
		display: flex;
		align-items: center;
		gap: 10px;
		color: var(--text);
		text-decoration: none;
		font-weight: 600;
	}

	.brand:hover {
		text-decoration: none;
	}

	/* 导航栏左侧的图标（public/logo.png，256×256 的方形图，这里显示 34×34） */
	.brand-mark {
		width: 34px;
		height: 34px;
		/* 不参与 flex 压缩，否则窄屏下会被挤扁 */
		flex-shrink: 0;
		border-radius: 8px;
	}

	.brand-text {
		font-size: 1rem;
	}

	/* ---- ② 中：菜单（占中间那一格，靠 justify-self 居中）---- */
	.nav-links {
		justify-self: center;
		display: flex;
		align-items: center;
		gap: 4px;
	}

	/* ---- ③ 右：立即下载按钮 + 汉堡按钮 ---- */
	.nav-right {
		justify-self: end;
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.nav-link {
		padding: 8px 14px;
		border-radius: 8px;
		color: var(--text-muted);
		font-size: 0.95rem;
		text-decoration: none;
		/* 菜单项一律不换行。窗口偏窄时宁可让它稍微挤一点，
		   也不要出现某个菜单项被拆成两行、把导航栏撑高 */
		white-space: nowrap;
		transition: color 0.15s, background 0.15s;
	}

	.nav-link:hover {
		color: var(--text);
		background: var(--bg-soft);
		text-decoration: none;
	}

	/* 当前所在页高亮 */
	.nav-link.active {
		color: var(--brand);
		background: color-mix(in srgb, var(--brand) 10%, transparent);
	}

	/* ---- 右侧的方形图标按钮 ----
	   GitHub 链接和深浅色切换共用这一套外观：36×36、细边框、悬停时变品牌色。
	   想让某个图标单独长得不一样，给它单独加一条规则即可。 */
	.nav-icon-btn {
		display: grid;
		place-items: center;
		/* 现在它在右侧那一组里，由那个容器的 gap 控制间距，不需要额外 margin */
		flex-shrink: 0;
		width: 36px;
		height: 36px;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: transparent;
		color: var(--text-muted);
		/* GitHub 那个是 <a>，去掉默认下划线 */
		text-decoration: none;
		cursor: pointer;
		transition: color 0.15s, border-color 0.15s;
	}

	.nav-icon-btn:hover {
		color: var(--brand);
		border-color: var(--brand);
		text-decoration: none;
	}

	/* 太阳 / 月亮两个图标，同一时刻只显示一个：
	   深色模式显示太阳（点了会变亮），浅色模式显示月亮。

	   ⚠ 顺序很关键：必须先写【默认状态】的规则。
	   之前的写法只写了「带 data-theme 属性」和「系统深色」两种情况，
	   于是在【用户没手动切换过 + 系统是浅色】时一条都不匹配，
	   两个图标就同时冒出来了 —— 这正是刚进入官网时看到两个图标的原因。 */
	.icon-sun {
		display: none;
	}

	.icon-moon {
		display: block;
	}

	/* 用户手动切到了深色 */
	:global(:root[data-theme='dark']) .icon-sun {
		display: block;
	}

	:global(:root[data-theme='dark']) .icon-moon {
		display: none;
	}

	/* 用户没手动切过、而系统是深色 */
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .icon-sun {
			display: block;
		}

		:global(:root:not([data-theme='light'])) .icon-moon {
			display: none;
		}
	}

	/* ---- 汉堡按钮（默认隐藏，窄屏才出现） ---- */
	.nav-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 40px;
		height: 40px;
		padding: 0 9px;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: transparent;
		cursor: pointer;
	}

	.nav-toggle span {
		display: block;
		height: 2px;
		background: var(--text);
		border-radius: 1px;
	}

	/* ---- 窄屏适配：菜单收进下拉面板 ----
	   ⚠ 断点为什么是 860px 而不是更小：
	   三栏布局是「1fr auto 1fr」，中间那栏固定是菜单的宽度，
	   两侧各分一半剩余空间 —— 靠这个才做到严格居中。
	   但 1fr 的「最小值」是内容宽度，一旦两侧内容比分配到的宽度还宽，
	   列宽就会失衡，中间那栏跟着偏离中心。
	   实测菜单加到 6 项后，窗口窄于约 840px 时菜单就会开始偏移，
	   所以干脆在 860px 就把菜单收进下拉面板。 */
	@media (max-width: 860px) {
		/* 窄屏不再是三栏，退回两端对齐。
		   ⚠ 这里必须同样写成两级选择器，否则优先级低于上面的
		     「.site-nav .nav-inner」，display: flex 会被那条 grid 规则压回去。 */
		.site-nav .nav-inner {
			display: flex;
			justify-content: space-between;
			max-width: none;
			/* 手机上屏幕本来就窄，左右各 32px 太浪费，收一点 */
			padding: 0 20px;
		}

		/* 手机上收起右上角那个下载按钮 —— 下拉菜单里已经有「下载」入口了 */
		.nav-cta {
			display: none;
		}

		.nav-toggle {
			display: flex;
		}

		.brand-text {
			display: none;
		}

		.nav-links {
			position: absolute;
			top: 64px;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: 8px 16px 16px;
			background: var(--bg);
			border-bottom: 1px solid var(--border);
			/* 默认收起，加 .open 才展开 */
			display: none;
		}

		.nav-links.open {
			display: flex;
		}

		.nav-link {
			padding: 12px 14px;
		}

		/* 主题按钮现在待在右侧那一组里（和汉堡按钮并排），保持圆形小按钮就行，
		   不用再铺满下拉面板的宽度 */
		.nav-right {
			gap: 8px;
		}
	}
</style>
