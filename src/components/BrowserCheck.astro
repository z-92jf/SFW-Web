---
// ============================================================
//  浏览器过旧提示（改用 browser-update.org）
//
//  挂在 BaseLayout 里，所以【每个页面】都会跑。
//
//  为什么换成第三方脚本：
//    自己维护一份"最低版本表"跟不上浏览器发版，设备与国产浏览器
//    内核的判断也容易误报。browser-update.org 持续更新检测规则，
//    只在真的过旧时出现，而且它会按用户系统语言给出更新页。
//
//  ★ 要改最低版本：改下面脚本里 required 那几个数字
//  ★ 想改提示外观：改本文件底部的样式（覆盖 .buorg 即可）
//  ★ 不想要这个功能：去 src/layouts/BaseLayout.astro 把
//     <BrowserCheck /> 那一行删掉
//
//  几个刻意的做法：
//    · 加载器用 is:inline 内联输出、且全部用 ES5 语法。
//      这个脚本要检测的正是「老浏览器」，如果它自己被打包成
//      ES module，不支持 module 的浏览器根本不会执行，检查就白做。
//    · 提示条的样式不用 color-mix()/clamp()/gap，颜色先写死再写
//      变量 —— 同理，它得比页面本体更"耐老"。
//    · 只是「加载」第三方脚本，脚本挂了或域名不通时页面照常显示。
//
//  怎么自测：网址后面加 #test-bu（例：/top#test-bu），提示条无条件出现。
// ============================================================
---

<script is:inline>
	(function () {
		/* ------------------------------------------------------------
		   本站需要的最低版本。

		   数字不是随手定的 —— 站点重度依赖 CSS 的 color-mix()（18 处），
		   低于下面这些版本时它整个失效，表现为卡片图标底色、部分边框消失。
		     color-mix()  ——  Chrome/Edge 111 · Firefox 113 · Safari 16.2

		   直接写具体版本号而不是负数（"落后最新版几个版本"），
		   是因为负数会随着浏览器发版不断抬高门槛，容易误报。
		   ★ 以后页面用上更新的 CSS 特性，记得回来改这里。
		   ------------------------------------------------------------ */
		window.$buoop = {
			api: 2026.11, // 官方 API 版本，请勿删除

			required: {
				e: 111, // Edge
				i: 111, // IE（本站不支持，写在这里让 IE 也被拦下）
				c: 111, // Chrome
				f: 113, // Firefox
				o: 97, // Opera（对应 Chromium 111）
				s: '16.2', // Safari，带小数点必须用字符串
			},

			// 有严重安全漏洞（可被远程执行代码）的版本也提示
			insecure: true,

			// 厂商已停止支持、但不算太旧的版本不提示 —— 宁可漏报也别误报
			unsupported: false,

			// 固定中文：本站只有中文内容
			l: 'zh',

			// 底部条；不挤压页面布局（挤压会让锚点跳转算错位置）
			style: 'bottom',
			shift_page_down: false,

			// 一天最多出现一次；手动关掉后隔 7 天再说
			reminder: 24,
			reminderClosed: 168,

			// 更新页在新标签打开，不丢当前页面
			newwindow: true,

			text: {
				msg: '你的浏览器 {brow_name} 版本过旧，本站可能无法正常显示。',
				insecure: '你的浏览器 {brow_name} 存在严重安全漏洞，本站可能无法正常显示。',
				msgmore: '更新后可以正常使用本站的全部功能，也更安全。',
				bupdate: '更新浏览器',
				bignore: '忽略',
				remind: '{days} 天后再次提醒。',
				bnever: '不再提示',
			},
		};

		function buLoad() {
			var s = document.createElement('script');
			s.src = 'https://browser-update.org/update.min.js';
			s.async = true;
			document.body.appendChild(s);
		}

		// 等 body 出来再插，避免脚本自己拿不到 document.body
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', buLoad, false);
		} else {
			buLoad();
		}
	})();
</script>

<style is:global>
	/* ------------------------------------------------------------
	   覆盖 browser-update.org 的默认外观（淡黄条 + 绿色按钮），
	   让它跟站点配色一致。

	   每条都带 !important —— 第三方样式是运行时插进来的，
	   不加优先级压不住。颜色先写死再写变量：不支持 CSS 变量的
	   老浏览器会用第一条，不至于变成透明底。
	   ------------------------------------------------------------ */
	.buorg {
		background: #ffffff !important;
		background: var(--card, #ffffff) !important;
		color: #1a1d21 !important;
		color: var(--text, #1a1d21) !important;
		border-top: 1px solid #e3e8ef !important;
		border-bottom: 1px solid #e3e8ef !important;
		box-shadow: 0 -6px 24px rgba(16, 24, 32, 0.12) !important;
		font-family: inherit !important;
		font-size: 0.9rem !important;
		text-align: center !important;
	}

	.buorg-pad {
		padding: 12px 16px !important;
		line-height: 1.7 !important;
	}

	.buorg div {
		max-width: 900px;
		margin: 0 auto;
	}

	/* 「更新浏览器」：实心主色 */
	#buorgul {
		display: inline-block !important;
		margin: 4px 4px 0 !important;
		padding: 3px 13px !important;
		background: #005a9e !important;
		background: var(--brand, #005a9e) !important;
		color: #ffffff !important;
		border: 0 !important;
		border-radius: 7px !important;
		box-shadow: none !important;
		font-weight: 500 !important;
		text-decoration: none !important;
		cursor: pointer;
		white-space: nowrap;
	}

	/* 「忽略」「不再提示」：描边按钮，弱化处理 */
	#buorgig,
	#buorgpermanent {
		display: inline-block !important;
		margin: 4px 4px 0 !important;
		padding: 3px 13px !important;
		background: transparent !important;
		color: #5b6470 !important;
		color: var(--text-muted, #5b6470) !important;
		border: 1px solid #e3e8ef !important;
		border: 1px solid var(--border, #e3e8ef) !important;
		border-radius: 7px !important;
		box-shadow: none !important;
		font-weight: 400 !important;
		text-decoration: none !important;
		cursor: pointer;
		white-space: nowrap;
	}

	#buorgul:hover,
	#buorgig:hover,
	#buorgpermanent:hover {
		filter: brightness(1.06);
	}

	/* 深色：卡片底 + 浅色字，跟站点其它浮层一致 */
	:root[data-theme='dark'] .buorg {
		background: #1e2127 !important;
		color: #e6e9ee !important;
		border-top-color: #2c313a !important;
		border-bottom-color: #2c313a !important;
		box-shadow: 0 -6px 24px rgba(0, 0, 0, 0.4) !important;
	}

	:root[data-theme='dark'] #buorgul {
		background: #4aa3f0 !important;
		color: #0f1318 !important;
	}

	:root[data-theme='dark'] #buorgig,
	:root[data-theme='dark'] #buorgpermanent {
		color: #a2abb8 !important;
		border-color: #2c313a !important;
	}

	@media (prefers-color-scheme: dark) {
		:root:not([data-theme='light']) .buorg {
			background: #1e2127 !important;
			color: #e6e9ee !important;
			border-top-color: #2c313a !important;
			border-bottom-color: #2c313a !important;
			box-shadow: 0 -6px 24px rgba(0, 0, 0, 0.4) !important;
		}

		:root:not([data-theme='light']) #buorgul {
			background: #4aa3f0 !important;
			color: #0f1318 !important;
		}

		:root:not([data-theme='light']) #buorgig,
		:root:not([data-theme='light']) #buorgpermanent {
			color: #a2abb8 !important;
			border-color: #2c313a !important;
		}
	}
</style>
