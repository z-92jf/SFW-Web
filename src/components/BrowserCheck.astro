---
// ============================================================
//  浏览器 / 设备兼容性检查
//
//  挂在 BaseLayout 里，所以【每个页面】都会跑。
//
//  它干两件事：
//    ① 看浏览器版本够不够新
//    ② 看设备是不是手机 / 平板
//  任一条不合格，就在页面底部弹一个黄色方框说明原因，右上角有叉可以关掉。
//
//  ★ 要改最低版本：改下面脚本里 MIN 那个对象，注释写了每个数字的来历。
//  ★ 想改提示样式：改本文件底部的 <style>。
//  ★ 不想要这个功能：去 src/layouts/BaseLayout.astro 把 <BrowserCheck />
//     那一行删掉即可。
//
//  几个刻意的做法，写在前面免得以后被"优化"掉：
//    · 脚本用 is:inline 内联输出、且全部用 ES5 语法。
//      原因：这个脚本要检测的正是「老浏览器」，如果它自己被 Astro
//      打包成 ES module，那些不支持 module 的浏览器根本不会执行它，
//      检查就形同虚设。内联 + ES5 才能保证「再老的浏览器也能跑起来并看到提示」。
//    · 提示条自己的样式也不用 color-mix / clamp / gap 这些新特性，
//      同理 —— 它的样式必须比页面本体更"耐老"。
// ============================================================
---

<div class="bc" id="bc" role="status" hidden>
	<div class="bc-box">
		<button class="bc-close" type="button" id="bcClose" aria-label="关闭提示" title="关闭">×</button>
		<p class="bc-text" id="bcText"></p>
	</div>
</div>

<script is:inline>
	(function () {
		/* ------------------------------------------------------------
		   最低支持的版本。
		   数字不是随手定的 —— 本站重度依赖 CSS 的 color-mix()（18 处），
		   低于下面这些版本时它整个失效，表现为卡片图标底色、部分边框消失。
		     color-mix()  ——  Chrome/Edge 111 · Firefox 113 · Safari 16.2
		   （站点还用了 overflow: clip、backdrop-filter、scroll-snap，
		     但它们的门槛都比 color-mix() 低，所以以 color-mix() 为准。）

		   ★ 以后如果页面用上了更新的 CSS 特性，记得回来抬高这里的数字。
		   ★ 想放宽：把数字调小即可，宁可漏报也别误报。
		   ------------------------------------------------------------ */
		var MIN_CHROMIUM = 111; // Chrome / Edge / Opera 以及各种国产浏览器（都是 Chromium 内核）
		var MIN_FIREFOX = 113;
		var MIN_SAFARI_MAJOR = 16; // Safari 要 16.2，所以主版本 16 + 次版本 2
		var MIN_SAFARI_MINOR = 2;

		var ua = navigator.userAgent || '';
		var maxTouch = navigator.maxTouchPoints || 0;

		/* ---------- 小工具：从 UA 里抠一个数字 ---------- */
		function pick(str, re) {
			var m = str.match(re);
			return m ? parseInt(m[1], 10) : 0;
		}

		/* ---------- 品牌名美化 ----------
		   userAgentData 里的品牌名是全称（Google Chrome / Microsoft Edge），
		   显示给用户看的时候短一点更清楚 */
		function prettyBrand(name) {
			if (/Google Chrome/i.test(name)) return 'Chrome';
			if (/Microsoft Edge/i.test(name)) return 'Edge';
			if (/Opera/i.test(name)) return 'Opera';
			if (/Vivaldi/i.test(name)) return 'Vivaldi';
			if (/Brave/i.test(name)) return 'Brave';
			return name;
		}

		/* ---------- ① 识别浏览器 ---------- */
		var family = 'unknown'; // chromium / firefox / safari / ie / unknown
		var name = '';
		var major = 0;
		var minor = 0;

		/* Chrome 90+ 提供了 userAgentData.brands，比 UA 字符串更不容易被伪装。
		   但只有 Chromium 系才有，所以仅用来补充品牌名 */
		var brand = null;
		if (navigator.userAgentData && navigator.userAgentData.brands) {
			for (var i = 0; i < navigator.userAgentData.brands.length; i++) {
				var b = navigator.userAgentData.brands[i];
				// 跳过 "Not/A)Brand" 这类占位项和光秃秃的 Chromium
				if (!/Not.?A.?Brand/i.test(b.brand) && b.brand !== 'Chromium') {
					brand = b;
					break;
				}
			}
		}

		/* ⚠ 判断顺序不能改：
		   Edge / Opera / 国产浏览器的 UA 里【同时】含有 "Chrome" 和 "Safari"，
		   而 Chrome 的 UA 里也含有 "Safari"。
		   所以必须先挑"更具体"的，最后才轮到 Chrome 和 Safari。 */
		if (/Edg(?:e|A|iOS)?\//.test(ua)) {
			family = 'chromium';
			name = 'Edge';
			major = pick(ua, /Edg(?:e|A|iOS)?\/(\d+)/);
		} else if (/OPR\//.test(ua)) {
			family = 'chromium';
			name = 'Opera';
			major = pick(ua, /OPR\/(\d+)/);
		} else if (/Firefox\//.test(ua)) {
			family = 'firefox';
			name = 'Firefox';
			major = pick(ua, /Firefox\/(\d+)/);
		} else if (/Chrome\//.test(ua)) {
			/* 走到这里说明不是 Edge / Opera，但可能是 QQ、360、UC 这类国产浏览器
			   —— 它们都用 Chromium 内核，版本号也确实写在 Chrome/ 后面，
			   报"内核版本"正好是它们该报的东西。 */
			family = 'chromium';
			major = pick(ua, /Chrome\/(\d+)/);
			if (/QQBrowser\//.test(ua)) name = 'QQ 浏览器';
			else if (/MicroMessenger\//.test(ua)) name = '微信内置浏览器';
			else if (/UCBrowser\//.test(ua)) name = 'UC 浏览器';
			else if (/MetaSr|SE 2\.X|TheWorld/i.test(ua)) name = '搜狗浏览器';
			else if (/Vivaldi/.test(ua)) name = 'Vivaldi';
			else name = brand ? prettyBrand(brand.brand) : 'Chrome';
		} else if (/Version\//.test(ua) && /Safari\//.test(ua)) {
			/* Safari 的版本号不在 Safari/ 后面，而在 Version/ 里。
			   比如：Version/16.2 Safari/605.1.15 —— 16.2 才是我们要的 */
			family = 'safari';
			name = 'Safari';
			major = pick(ua, /Version\/(\d+)/);
			minor = pick(ua, /Version\/\d+\.(\d+)/);
		} else if (/MSIE |Trident\//.test(ua)) {
			family = 'ie';
			name = 'Internet Explorer';
			major = pick(ua, /(?:MSIE |rv:)(\d+)/);
		}

		/* ---------- ② 判断版本够不够 ---------- */
		function tooOld() {
			if (family === 'ie') return true; // IE 一律不合格
			if (family === 'unknown') return false; // 认不出来就别打扰人家
			if (family === 'chromium') return major < MIN_CHROMIUM;
			if (family === 'firefox') return major < MIN_FIREFOX;
			if (family === 'safari') {
				if (major < MIN_SAFARI_MAJOR) return true;
				// 正好是主版本 16 时，还要看次版本够不够 16.2
				return major === MIN_SAFARI_MAJOR && minor < MIN_SAFARI_MINOR;
			}
			return false;
		}

		/* ---------- ③ 识别设备 ---------- */
		function detectDevice() {
			/* iPadOS 13 之后的 Safari 会把自己伪装成 macOS 桌面版，
			   光看 UA 认不出来。破绽是多点触控：Mac 的触控板不计入
			   maxTouchPoints，而 iPad 会返回 5。

			   ⚠ 这里只能认 "Macintosh"，【不能】把 "Mac OS X" 也写进来 ——
			   iPhone 的 UA 是「(iPhone; CPU iPhone OS 17_0 like Mac OS X)」，
			   带上 "Mac OS X" 的话手机会被误判成 iPad。（实测踩到过） */
			if (/iPad/.test(ua) || (/Macintosh/.test(ua) && maxTouch > 1)) {
				return 'iPad';
			}
			if (/Tablet|PlayBook|Silk|Kindle|Xoom/i.test(ua)) return '平板设备';
			if (/Android/i.test(ua)) {
				// Android 平板和手机的唯一区别就是 UA 里有没有 "Mobile"
				return /Mobile/i.test(ua) ? '手机' : 'Android 平板';
			}
			if (/iPhone|iPod/i.test(ua)) return 'iPhone';
			if (/Windows Phone|IEMobile/i.test(ua)) return '手机';
			return ''; // 空字符串 = 桌面，不用提示
		}

		/* ---------- ④ 组装提示 ----------
		   浏览器版本和设备只会报【一条】：
		   版本问题的后果是"页面直接坏掉"，比"设备体验差"严重，所以优先报它。
		   真要两个都报，也不符合提示条"一句话说清"的定位。 */
		var message = '';

		if (tooOld()) {
			/* Safari 的版本号习惯写成两段（16.2），所以次版本即使是 0 也带上 ——
			   Version/16.0 显示成「16.0」比显示「16」准确。
			   其它浏览器只在次版本确实非 0 时才带。 */
			var ver = '';
			if (major) {
				ver = String(major);
				if (family === 'safari' || minor > 0) ver = ver + '.' + minor;
			}
			var who = (name || '当前浏览器') + (ver ? ' ' + ver : '');
			message = '您正在使用的浏览器是 ' + who + '，可能会导致页面无法正常显示。尝试安装最新版本浏览器。';
		} else {
			var device = detectDevice();
			if (device) {
				message = '您正在使用的设备是 ' + device + '，可能会导致页面无法正常显示。尝试切换设备。';
			}
		}

		if (!message) return; // 一切正常，什么都不做

		/* ---------- ⑤ 显示 ---------- */
		function show() {
			var box = document.getElementById('bc');
			var text = document.getElementById('bcText');
			var close = document.getElementById('bcClose');
			if (!box || !text) return;

			text.textContent = message;
			box.hidden = false;

			// 下一帧再加动画类，这样过渡才会生效（直接加会跳过动画）
			setTimeout(function () {
				box.classList.add('bc-show');
			}, 20);

			if (close) {
				close.onclick = function () {
					box.classList.remove('bc-show');
					// 等淡出动画走完再真正隐藏
					setTimeout(function () {
						box.hidden = true;
					}, 250);
				};
			}
		}

		// 等页面主体渲染出来再弹，避免跟首屏内容抢注意力
		if (document.readyState === 'complete' || document.readyState === 'interactive') {
			setTimeout(show, 600);
		} else {
			document.addEventListener('DOMContentLoaded', function () {
				setTimeout(show, 600);
			});
		}
	})();
</script>

<style>
	/* ------------------------------------------------------------
	   提示条。
	   这里【故意】不用 color-mix()、clamp()、gap 这些新特性 ——
	   它要给老浏览器看，自己的样式必须先扛得住。
	   ------------------------------------------------------------ */
	.bc {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 9999;
		display: flex;
		justify-content: center;
		padding: 0 16px 16px;
		/* 容器不接收鼠标事件，只有里面那个方框接收 ——
		   否则这条横贯整屏的容器会挡住它上方区域的点击 */
		pointer-events: none;
		opacity: 0;
		transform: translateY(14px);
		transition: opacity 0.35s ease, transform 0.35s ease;
	}

	/* hidden 属性优先。老浏览器不一定认 hidden，所以显式写一遍 */
	.bc[hidden] {
		display: none;
	}

	.bc-show {
		opacity: 1;
		transform: translateY(0);
	}

	.bc-box {
		position: relative;
		width: 100%;
		max-width: 800px;
		/* 右边留宽一点，别让文字跑到关闭按钮底下 */
		padding: 14px 46px 14px 18px;
		background: #fff8e1;
		border: 1px solid #f0c674;
		border-radius: 10px;
		box-shadow: 0 6px 24px rgba(0, 0, 0, 0.14);
		color: #6b4e16;
		font-size: 0.9rem;
		line-height: 1.7;
		pointer-events: auto;
	}

	.bc-text {
		margin: 0;
	}

	/* 右上角的褐色叉叉 */
	.bc-close {
		position: absolute;
		top: 4px;
		right: 4px;
		width: 32px;
		height: 32px;
		padding: 0;
		border: 0;
		background: transparent;
		color: #8a6034;
		font-family: inherit;
		font-size: 20px;
		line-height: 1;
		cursor: pointer;
		border-radius: 6px;
		transition: background 0.15s, color 0.15s;
	}

	.bc-close:hover {
		background: rgba(138, 96, 52, 0.14);
		color: #6b4423;
	}

	/* ---- 深色模式：换成深黄底 + 浅黄字，避免暗色页面上一块刺眼的白 ---- */
	:global(:root[data-theme='dark']) .bc-box {
		background: #3a2f13;
		border-color: #6b5522;
		color: #f0dca8;
		box-shadow: 0 6px 24px rgba(0, 0, 0, 0.5);
	}

	:global(:root[data-theme='dark']) .bc-close {
		color: #c9a468;
	}

	:global(:root[data-theme='dark']) .bc-close:hover {
		background: rgba(201, 164, 104, 0.18);
		color: #e8c88a;
	}

	@media (max-width: 560px) {
		.bc-box {
			font-size: 0.86rem;
			padding: 12px 42px 12px 14px;
		}
	}
</style>
