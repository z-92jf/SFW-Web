---
// ============================================================
//  页脚
//
//  ★ 要改：版权归属、起始年份、联系方式 →
//    全部在 src/data/site.ts 的 footer 和 contact 里改，
//    不用动这个文件。
// ============================================================

import { site, links, contact, footer, footerNav } from '../data/site';

// 自动算出年份区间，比如 2024–2026。
// 如果今年和起始年份相同，就只显示一个年份，不会出现「2026-2026」
const now = new Date().getFullYear();
const yearRange = now > footer.since ? `${footer.since}-${now}` : `${now}`;

// 把联系方式的「用途 → 邮箱」整理成数组，空的自动过滤掉。
// 这样你哪天删掉某一行邮箱，页面上也会跟着少一行，不留空标签
const contactList = [
	{ label: '想加入我们', mail: contact.join },
	{ label: '想投诉', mail: contact.report },
	{ label: '想发布评论', mail: contact.comment },
].filter((c) => c.mail && c.mail.trim() !== '');
---

<footer class="site-footer">
	<div class="container">
		<div class="footer-grid">
			<!-- 第一列：一句话简介。
			     大字 logo 已经挪到这个页脚的最底下了（铺满整行）。 -->
			<div>
				<p class="text-muted footer-tagline">{site.tagline}</p>
			</div>

			<!-- 第二列：站内导航。
			     清单在 src/data/site.ts 的 footerNav 里，以后增删页面改那里即可。
			     项目比较多，排成两列（见下面 .footer-list--cols） -->
			<div>
				<div class="footer-heading">导航</div>
				<ul class="footer-list footer-list--cols">
					{footerNav.map((item) => (
						<li><a href={item.href}>{item.text}</a></li>
					))}
				</ul>
			</div>

			<!-- 第三列：外部链接 -->
			<div>
				<div class="footer-heading">相关链接</div>
				<ul class="footer-list">
					<li><a href={links.github} target="_blank" rel="noopener">GitHub 仓库</a></li>
					<li><a href={links.releases} target="_blank" rel="noopener">GitHub Releases</a></li>
				</ul>
			</div>

			<!-- 第四列：联系方式。contactList 为空时整列不显示 -->
			{
				contactList.length > 0 && (
					<div>
						<div class="footer-heading">联系我们</div>
						<ul class="footer-list">
							{contactList.map((c) => (
								<li>
									{c.label}：<a href={`mailto:${c.mail}`}>{c.mail}</a>
								</li>
							))}
						</ul>
					</div>
				)
			}
		</div>

		<div class="footer-bottom">
			<span>© {yearRange} {footer.owner} All rights reserved.</span>
			{footer.extra && <span class="text-faint">{footer.extra}</span>}
		</div>

		<!-- ============================================================
		     底部通栏大字 logo
		     ★ 要换图：直接覆盖 public/img/wordmark-light.png 和 wordmark-dark.png。
		       但注意这两张图上下留白很大，这里是靠 CSS「裁」出来的，
		       换图后如果留白比例不同，要同步调 <style> 里 .footer-wordmark 的那 4 个百分比
		       （注释里写了每个数是怎么算出来的）。
		     ============================================================ -->
		<div class="footer-wordmark">
			<img class="wordmark-light" src="/img/wordmark-light.png" alt={site.title} />
			<img class="wordmark-dark" src="/img/wordmark-dark.png" alt="" aria-hidden="true" />
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 80px;
		padding: 56px 0 32px;
		background: var(--bg-soft);
		border-top: 1px solid var(--border);
		font-size: 0.92rem;
	}

	/* 四列：简介 / 导航 / 相关链接 / 联系我们。
	   第一列原来放的是大字 logo，现在 logo 挪到底部通栏了，
	   所以第一列不再需要那么宽，把空间让给「导航」（它要排两列）。
	   但第一列那句标语不能被挤到换行，所以仍给它 1.35fr。 */
	.footer-grid {
		display: grid;
		grid-template-columns: 1.35fr 1.1fr 0.95fr 1.35fr;
		gap: 32px;
	}

	.footer-brand {
		font-size: 1.05rem;
		font-weight: 600;
		margin-bottom: 6px;
	}

	/* ---- 页脚底部的通栏大字 logo ----
	   原图是 1783×582，但真正的文字只占中间 1647×102 那一条，
	   上下各有一大块空白。如果整张图直接按 100% 宽显示，
	   文字会缩得很小、而且上下各留一大片空白。

	   所以这里做一个「裁剪窗口」把留白切掉：
	     · 窗口高度 = 容器宽 × 102/1647
	     · 图片放大到 1783/1647 倍，再用负 margin 把文字推到窗口正中
	   下面 4 个百分比都是从原图量出来的（相对【容器宽度】），

	   ★ 换了大字图、且新图留白比例不同时，按这个方法重新量一遍即可：
	       打开新图，量出【文字范围】的 left / top / 右边界 与整张图的宽高，
	       然后：窗口高 = 文字高 ÷ 文字宽
	             图片宽 = 原图宽 ÷ 文字宽
	             左移   = 文字左边距 ÷ 文字宽
	             上移   = 文字上边距 ÷ 文字宽
	     （当前这张：文字宽 1647、高 102、左 78、上 243、原图宽 1783） */
	.footer-wordmark {
		width: 100%;
		height: 0;
		/* 102 ÷ 1647 = 6.1931% —— 窗口高 : 窗口宽 */
		padding-bottom: 6.1931%;
		margin-top: 40px;
		overflow: hidden;
	}

	.footer-wordmark img {
		display: block;
		/* 1783 ÷ 1647 = 108.2574% —— 放大后，文字正好铺满容器宽度 */
		width: 108.2574%;
		height: auto;
		/* ⚠ 必须放开这条：全局样式里有「img { max-width: 100% }」，
		   不覆盖的话图片会被卡在容器宽度上，放大 108% 那一步就失效了
		   （实测踩到过：图片量出来只有容器宽，文字也就没铺满）。 */
		max-width: none;
		/* 78 ÷ 1647 = 4.7359% —— 把左边那块留白推出窗口 */
		margin-left: -4.7359%;
		/* 243 ÷ 1647 = 14.7541% —— 把上边那块留白推出窗口 */
		margin-top: -14.7541%;
	}

	/* 这两张图都不是透明背景（一张纯白底、一张纯黑底），
	   直接放上去会在页脚上留出一个方块。
	   用混合模式把底色「滤掉」就能融进页脚：
	     multiply → 白色变成背景色（浅色模式）
	     screen   → 黑色变成背景色（深色模式） */
	.wordmark-light {
		mix-blend-mode: multiply;
	}

	.wordmark-dark {
		mix-blend-mode: screen;
	}

	/* 默认只显示浅色那张。
	   ⚠ 选择器要多带一个 .footer-wordmark，否则压不过上面那条
	     「.footer-wordmark img { display: block }」。 */
	.footer-wordmark .wordmark-dark {
		display: none;
	}

	/* 深色模式：换成黑底那张 */
	:global(:root[data-theme='dark']) .footer-wordmark .wordmark-light {
		display: none;
	}

	:global(:root[data-theme='dark']) .footer-wordmark .wordmark-dark {
		display: block;
	}

	/* 用户没手动切过、系统是深色时也一样 */
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .footer-wordmark .wordmark-light {
			display: none;
		}

		:global(:root:not([data-theme='light'])) .footer-wordmark .wordmark-dark {
			display: block;
		}
	}

	.footer-tagline {
		margin: 0;
		font-size: 0.9rem;
	}

	.footer-heading {
		font-weight: 600;
		margin-bottom: 10px;
	}

	.footer-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.footer-list li {
		margin-bottom: 6px;
		color: var(--text-muted);
	}

	/* 「导航」那一列项目多，排成两列，免得拉成很长的一条。
	   加这个类只会影响用到它的那个列表，其他地方照旧是单列。 */
	.footer-list--cols {
		display: grid;
		grid-template-columns: 1fr 1fr;
		/* 行距靠 li 的 margin-bottom，这里只管列间距 */
		column-gap: 20px;
	}

	.footer-list a {
		color: var(--text-muted);
	}

	.footer-list a:hover {
		color: var(--brand);
	}

	.footer-bottom {
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 40px;
		padding-top: 20px;
		border-top: 1px solid var(--border);
		color: var(--text-faint);
		font-size: 0.85rem;
	}

	/* 窄屏：两列变一列 */
	@media (max-width: 860px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 520px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
