---
// ============================================================
//  按「发布主题」分组的页面（路径 /news/category/<英文slug>）
//
//  比如 /news/category/devlog/ 会列出所有主题为「开发日志」的文章。
//
//  ★ 这些页面是构建时自动生成的 —— 你在 md 里用了哪个主题，
//    就会自动多出一个对应的页面，不需要手动建文件。
//  ★ 想改主题名，改 src/data/site.ts 的 newsCategories。
//
//  网址里用的是英文 slug 而不是中文名，是为了让链接短、好分享
//  （中文直接进网址会变成一长串 %E5%BC%80…）。
// ============================================================

import NewsArchive from '../../components/NewsArchive.astro';
import { getNewsPosts } from '../../lib/news';
import { newsCategories } from '../../data/site';

export async function getStaticPaths() {
	const posts = await getNewsPosts();

	// 只给【真的有文章】的主题生成页面。
	// 空页面会被搜索引擎当成低质量内容，不如不生成
	return newsCategories
		.filter((cat) => posts.some((p) => p.data.category === cat.name))
		.map((cat) => ({
			params: { category: cat.slug },
			props: {
				name: cat.name,
				posts: posts.filter((p) => p.data.category === cat.name),
			},
		}));
}

const { name, posts } = Astro.props;
---

<NewsArchive
	title={name}
	subtitle={`主题「${name}」，共 ${posts.length} 篇。`}
	posts={posts}
	crumb="主题"
/>
