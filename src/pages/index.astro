---
// ============================================================
//  欢迎页（网站根路径 /）
//
//  这是一个「纵向滚动的整屏引导页」：
//  整个页面被切成若干屏，每一屏高度占满整个浏览器窗口，
//  用户往下滚一次就前进一屏，滚到最后一屏按「进入官网」跳到 /top。
//
//  实现方式是最朴素的 CSS 滚动吸附（scroll-snap），
//  没有引入任何动画库，所以体积极小、也不会卡。
//
//  ★ 要改内容：
//    - 产品名、简介、版本 → src/data/site.ts
//    - 每一屏的文案        → 就在下面 <Section> 里，直接改文字
//    - 想加一屏            → 复制一整段 <Section>...</Section> 即可
// ============================================================

import BaseLayout from '../layouts/BaseLayout.astro';
import { site, links } from '../data/site';

// 从内容集合里读最新的更新日志，第三屏用来展示「最新动态」
import { getCollection } from 'astro:content';
const latest = (
	await getCollection('changelog', ({ data }) => !data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];
---

<!-- showChrome={false}：欢迎页不显示导航栏和页脚 -->
<BaseLayout showChrome={false} bodyClass="welcome-page">
	<!-- ============================================================
	     第一屏：产品名 + 一句话简介
	     ============================================================ -->
	<section class="screen screen-hero">
		<div class="screen-inner">
			<p class="hero-eyebrow reveal">{site.tagline}</p>
			<h1 class="hero-title reveal">{site.title}</h1>
			<p class="hero-sub reveal">
				把 Windows 上零散的实用功能收进一个控制台里。<br />
				账户、游戏、系统快捷方式、进制转换，一次到位。
			</p>
			<div class="hero-meta reveal">
				<span class="badge badge-brand">v{site.version}</span>
				<span class="badge">{site.versionStage}</span>
			</div>
		</div>

		<!-- 向下滚动提示。纯 CSS 做的上下浮动动画 -->
		<div class="scroll-hint reveal" aria-hidden="true">
			<span class="scroll-hint-text">向下滚动</span>
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M12 5v14M6 13l6 6 6-6" />
			</svg>
		</div>
	</section>

	<!-- ============================================================
	     第二屏：核心亮点
	     ★ 要改：这里写的是概览式的短句。
	       首页（/top）上才是详细的功能卡片，两边不重复。
	     ============================================================ -->
	<section class="screen">
		<div class="screen-inner">
			<h2 class="screen-title reveal">它解决什么问题</h2>
			<p class="screen-sub reveal">Windows 自带的功能散落在各处，找起来费时。</p>

			<ul class="point-list">
				<li class="point reveal">
					<span class="point-num">01</span>
					<div>
						<h3>不用再翻开始菜单</h3>
						<p>一百项常用系统功能集中管理，找设置就是选个编号的事。</p>
					</div>
				</li>
				<li class="point reveal">
					<span class="point-num">02</span>
					<div>
						<h3>账号数据不再丢</h3>
						<p>数据固定保存在程序所在目录，不管从哪儿启动都读同一份。</p>
					</div>
				</li>
				<li class="point reveal">
					<span class="point-num">03</span>
					<div>
						<h3>该有的都有</h3>
						<p>登录注册、小游戏、进制转换，一个控制台里全都齐了。</p>
					</div>
				</li>
			</ul>
		</div>
	</section>

	<!-- ============================================================
	     第三屏：最新版本动态
	     内容自动读自 src/content/changelog/ 里最新的一篇日志，
	     发新版本时不用改这个文件。
	     ============================================================ -->
	<section class="screen">
		<div class="screen-inner">
			<h2 class="screen-title reveal">最新版本</h2>
			<p class="screen-sub reveal">每一次更新都写在这里。</p>

			{
				latest ? (
					<div class="release-card reveal">
						<div class="release-head">
							<span class="badge badge-brand">v{latest.data.version}</span>
							<time class="text-faint">
								{latest.data.pubDate.toLocaleDateString('zh-CN')}
							</time>
						</div>
						<h3 class="release-title">{latest.data.title}</h3>
						{latest.data.summary && <p class="text-muted">{latest.data.summary}</p>}
						<a class="release-link" href={`/changelog/${latest.id}`}>
							查看完整更新说明 →
						</a>
					</div>
				) : (
					<p class="text-muted">暂无更新日志。</p>
				)
			}
		</div>
	</section>

	<!-- ============================================================
	     第四屏：入口
	     ★ 这一屏就是「点击最下方进入官网」的那一屏。
	     ============================================================ -->
	<section class="screen screen-final">
		<div class="screen-inner text-center">
			<h2 class="final-title reveal">准备好了吗</h2>
			<p class="final-sub reveal">进入官网查看完整功能说明与下载方式。</p>

			<div class="final-actions reveal">
				<a class="btn btn-primary btn-lg" href="/top">进入官网</a>
				<a class="btn btn-outline" href={links.download} target="_blank" rel="noopener">
					直接下载 v{site.version}
				</a>
			</div>

			<p class="text-faint final-note reveal">
				当前版本 v{site.version}（{site.versionStage}）· 发布于 {site.releaseDate}
			</p>
		</div>
	</section>

	<!-- ============================================================
	     跟随入口按钮
	     固定在右下角，让用户不必滚到底部也能进官网。
	     滚到最后一屏（底部那个「进入官网」出现）时会自动淡出，
	     避免同一个页面上同时出现两个入口。

	     ★ 不想要它，把下面这一整段删掉即可，其它地方不受影响。
	     ★ 想换位置：改样式里 .float-enter 的 right / bottom
	       （改 right 为 left 就跑到左下角）。
	     ============================================================ -->
	<a class="float-enter" href="/top" id="floatEnter">
		<span>进入官网</span>
		<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M5 12h14M13 6l6 6-6 6" />
		</svg>
	</a>
</BaseLayout>

<!-- ============================================================
     欢迎页专属样式
     用 is:global 是因为要作用到 <html> 上（开启滚动吸附）。
     这些样式只会被打进首页的 CSS 文件，其他页面加载不到，
     所以不用担心影响到 /top、/download 等页面。
     ============================================================ -->
<style is:global>
	/* 滚动吸附：y 方向、强制对齐。
	   mandatory 表示松手后一定会停在某一屏上；
	   如果觉得「粘」得太死，改成 proximity 会温和很多。 */
	html.snap-enabled {
		scroll-snap-type: y proximity;
	}

	/* 欢迎页每一屏 */
	.screen {
		min-height: 100vh;
		min-height: 100dvh; /* dvh 会扣掉手机浏览器地址栏的高度，更准 */
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 80px 24px;
		scroll-snap-align: start;
		position: relative;
	}

	.screen-inner {
		width: 100%;
		max-width: 820px;
	}

	/* ---- 第一屏 ---- */
	.screen-hero {
		flex-direction: column;
		text-align: center;
	}

	.hero-eyebrow {
		margin: 0 0 16px;
		color: var(--brand);
		font-size: 0.95rem;
		letter-spacing: 0.04em;
	}

	.hero-title {
		margin: 0 0 20px;
		/* clamp(最小, 随屏幕缩放, 最大)：字号随窗口大小自动变，
		   不用写一堆媒体查询 */
		font-size: clamp(2.2rem, 7vw, 4rem);
		letter-spacing: -0.02em;
	}

	.hero-sub {
		max-width: 560px;
		margin: 0 auto 28px;
		color: var(--text-muted);
		font-size: 1.05rem;
	}

	.hero-meta {
		display: flex;
		justify-content: center;
		gap: 8px;
	}

	/* 滚动提示固定在第一屏底部。
	   ⚠ 这里【不要】用 left:50% + translateX(-50%) 来居中。
	     因为这个元素同时还挂着 .reveal（入场动画），而 .reveal 也用 transform：
	     两条规则都是单类选择器，写在后面的 .reveal 会把 translateX(-50%) 覆盖掉，
	     结果就是提示横向跑偏半个身位。
	     改成 left/right 撑满 + align-items 居中，完全不碰 transform。 */
	.scroll-hint {
		position: absolute;
		bottom: 36px;
		left: 0;
		right: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 6px;
		color: var(--text-faint);
		font-size: 0.8rem;
	}

	.scroll-hint svg {
		animation: bob 1.8s ease-in-out infinite;
	}

	@keyframes bob {
		0%, 100% { transform: translateY(0); opacity: 0.6; }
		50% { transform: translateY(6px); opacity: 1; }
	}

	/* ---- 通用标题 ---- */
	.screen-title {
		text-align: center;
		margin-bottom: 10px;
		font-size: 1.9rem;
	}

	.screen-sub {
		text-align: center;
		color: var(--text-muted);
		margin-bottom: 44px;
	}

	/* ---- 第二屏：编号条目 ---- */
	.point-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 20px;
	}

	.point {
		display: flex;
		gap: 18px;
		padding: 22px 24px;
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
	}

	.point-num {
		font-family: var(--font-mono);
		font-size: 0.95rem;
		color: var(--brand);
		padding-top: 3px;
	}

	.point h3 {
		margin: 0 0 4px;
		font-size: 1.02rem;
	}

	.point p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.92rem;
	}

	/* ---- 第三屏：版本卡片 ---- */
	.release-card {
		padding: 30px 32px;
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow);
	}

	.release-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 14px;
	}

	.release-title {
		margin: 0 0 10px;
		font-size: 1.2rem;
	}

	.release-link {
		display: inline-block;
		margin-top: 8px;
		font-size: 0.92rem;
	}

	/* ---- 第四屏 ---- */
	.final-title {
		font-size: 2.2rem;
		margin-bottom: 12px;
	}

	.final-sub {
		color: var(--text-muted);
		margin-bottom: 36px;
	}

	.final-actions {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 14px;
	}

	.final-note {
		margin-top: 28px;
	}

	/* ------------------------------------------------------------
	   入场动画
	   .reveal 的元素初始是「透明 + 往下偏一点」，
	   被 IntersectionObserver 打上 .visible 后才滑入到位。
	   这样每翻一屏内容都会有一点动静，不至于干巴巴的。
	   ------------------------------------------------------------ */
	.reveal {
		opacity: 0;
		transform: translateY(22px);
		transition: opacity 0.65s ease, transform 0.65s ease;
	}

	.reveal.visible {
		opacity: 1;
		transform: none;
	}

	/* ------------------------------------------------------------
	   跟随入口按钮（右下角那个「进入官网」）
	   ⚠ 它【不能】加 .reveal 类：.reveal 用 transform 做入场动画，
	     会和这里的 .is-hidden 淡出效果互相覆盖，导致按钮位置错乱。
	   ------------------------------------------------------------ */
	.float-enter {
		position: fixed;
		right: 28px;
		bottom: 28px;
		z-index: 40;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 13px 24px;
		border-radius: 999px;
		background: var(--brand);
		color: #fff;
		font-size: 0.95rem;
		font-weight: 500;
		line-height: 1;
		text-decoration: none;
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
		transition: opacity 0.28s ease, transform 0.28s ease, background 0.15s;
	}

	.float-enter:hover {
		background: var(--brand-hover);
		text-decoration: none;
	}

	.float-enter svg {
		transition: transform 0.2s;
	}

	.float-enter:hover svg {
		transform: translateX(3px);
	}

	/* 底部入口出现时：淡出 + 微微下沉，并禁掉点击（避免误触看不见的按钮） */
	.float-enter.is-hidden {
		opacity: 0;
		transform: translateY(14px);
		pointer-events: none;
	}

	/* 窄屏上收小一点，免得挡住正文 */
	@media (max-width: 560px) {
		.float-enter {
			right: 16px;
			bottom: 16px;
			padding: 11px 18px;
			font-size: 0.88rem;
		}
	}

	/* 尊重系统的「减少动态效果」设置：
	   有晕动症的用户会打开这个开关，这时全部取消动画 */
	@media (prefers-reduced-motion: reduce) {
		html.snap-enabled {
			scroll-snap-type: none;
		}

		.reveal {
			opacity: 1;
			transform: none;
			transition: none;
		}

		.scroll-hint svg {
			animation: none;
		}

		.float-enter {
			transition: none;
		}
	}
</style>

<script>
	// ============================================================
	// 欢迎页专属脚本（只在浏览器执行）
	// ============================================================

	// ---- 1. 开启滚动吸附 ----
	// 给 <html> 加一个 class 来开启吸附，而不是直接写死全局样式。
	// 这样即使这份 CSS 被别的页面加载到，也不会误伤它们
	document.documentElement.classList.add('snap-enabled');

	// ---- 2. 逐屏入场动画 ----
	// 元素进入视口（大约露出三分之一）时加上 .visible，触发滑入
	const observer = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (entry.isIntersecting) {
					entry.target.classList.add('visible');
					// 只播一次就够了，播完停止观察，省性能
					observer.unobserve(entry.target);
				}
			}
		},
		{ threshold: 0.3 }
	);

	document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

	// ---- 3. 键盘支持 ----
	// 用方向键 / 空格 / PageUp、PageDown 也能翻屏。
	// 这里不用自己实现，浏览器对 scroll-snap 的原生滚动就支持，
	// 所以整段留空——写在这里只是提醒你「不需要额外写代码」。

	// ---- 4. 跟随入口按钮：滚到最后一屏时自动隐藏 ----
	// 盯着第四屏（.screen-final），它一进入视口就把右下角那个按钮藏起来，
	// 免得页面上同时出现两个「进入官网」。
	const floatEnter = document.getElementById('floatEnter');
	const finalScreen = document.querySelector('.screen-final');

	if (floatEnter && finalScreen) {
		const finalObserver = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					// 进来就加 is-hidden，退出去就移除
					floatEnter.classList.toggle('is-hidden', entry.isIntersecting);
				}
			},
			// 第四屏露出四分之一就算「出现了」。
			// 想让按钮更早消失就调小这个数，想更晚消失就调大。
			{ threshold: 0.25 }
		);

		finalObserver.observe(finalScreen);
	}
</script>
