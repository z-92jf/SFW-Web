---
// ============================================================
//  下载页（路径 /download）
//
//  ★ 要改：下载地址、版本号 → src/data/site.ts
//  ★ 要改：下面「系统要求」「安装步骤」里的文字 → 直接改本文件
//
//  ⚠ 重要：安装包不要提交进仓库，继续放在 GitHub Releases 上。
//    仓库里的文件会永久留在 Git 历史中，越滚越大；
//    而且 GitHub Pages 站点本身有 1GB 的容量上限。
// ============================================================

import BaseLayout from '../layouts/BaseLayout.astro';
import DependencyDialog from '../components/DependencyDialog.astro';
import { site, links, downloadMirror } from '../data/site';
---

<BaseLayout title="下载" description={`下载 SERVICES FOR Windows v${site.version}，适用于 Windows 10 及以上系统。`}>
	<section class="section">
		<div class="container">
			<!--
				标题区做成三栏（左入口 / 中标题 / 右入口）：
				中间那列宽度由内容决定、两侧各占一半剩余空间，
				所以标题仍然严格居中，两个入口分贴左右 —— 和导航栏用的是同一套办法。
				如果用 flex，两侧内容宽度不等会把标题挤偏。
			-->
			<div class="download-hero">
				{/* 左边：Win7 / 8 缺运行库时用的补丁。
				    点击开弹窗；没开 JS 时按钮本身就是下载站链接，照原样跳过去 */}
				{
					downloadMirror.trim() !== '' && (
						<a
							class="hero-entry dep-entry"
							href={downloadMirror}
							target="_blank"
							rel="noopener"
							data-dep-open
						>
							<span class="hero-entry-head">
								<svg
									width="18"
									height="18"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.8"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path d="M12 3 5 6v5.5c0 4.4 2.9 7.6 7 9 4.1-1.4 7-4.6 7-9V6l-7-3Z"></path>
									<path d="M12 9.5v4"></path>
									<path d="m10.4 12 1.6 1.6 1.6-1.6"></path>
								</svg>
								<span>Windows 7 / 8 依赖安装</span>
							</span>
							<span class="hero-entry-note">缺少运行库打不开时用 · 3 个补丁</span>
						</a>
					)
				}

				<div class="hero-text">
					<h1 class="section-title">下载</h1>
					<p class="section-subtitle">选择合适的方式安装软件。</p>
				</div>

				{/* 下载站没部署时（downloadMirror 为空）这块整体不渲染，标题照样居中 */}
				{
					downloadMirror.trim() !== '' && (
						<a
							class="hero-entry mirror-entry"
							href={downloadMirror}
							target="_blank"
							rel="noopener"
						>
							<span class="hero-entry-head">
								<svg
									width="18"
									height="18"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.8"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" />
								</svg>
								<span>前往 Cloudflare 全国分发下载站</span>
							</span>
							<span class="hero-entry-note">国内下载更快 · 全部历史版本</span>
						</a>
					)
				}
			</div>

			<!-- ============================================================
			     当前版本卡片
			     ============================================================ -->
			<div class="download-card">
				<div class="download-head">
					<div>
						<div class="download-version">v{site.version}</div>
						<div class="text-faint">发布于 {site.releaseDate}</div>
					</div>
					<span class="badge badge-brand">{site.versionStage}</span>
				</div>

				<p class="download-desc">
					适配 64 位 Windows 系统。请在下载后根据安装程序导向完成安装。
				</p>

				<div class="download-actions">
					<a class="btn btn-primary btn-lg" href={links.download} data-dl-version={site.version} target="_blank" rel="noopener">
						立即下载
					</a>
					<!-- 站内页面，不要加 target="_blank"，否则会另开一个标签页 -->
					<a class="btn btn-outline" href="/history">
						历史版本
					</a>
				</div>

				<p class="text-faint download-note">
					点击下载即表示你已阅读并同意我们的<a href="/license">许可证条款</a>。
				</p>
			</div>

			<!-- ============================================================
			     系统要求
			     ★ 要改：按实际情况调整
			     ============================================================ -->
			<div class="info-block">
				<h2>系统要求</h2>
				<table class="info-table">
					<tbody>
						<tr>
							<th>操作系统</th>
							<td>
								Windows 10 / 11（64 位），开箱即用<br />
								Windows 7 SP1 / 8.1（64 位），需要先装依赖补丁
							</td>
						</tr>
						<tr>
							<th>运行环境</th>
							<td>
								Windows 10 及以上无需额外运行库；
								Windows 7 / 8.1 缺 Universal C Runtime 时，用页面顶部的
								「Windows 7 / 8 依赖安装」补上
							</td>
						</tr>
						<tr>
							<th>磁盘占用</th>
							<td>约 10 MB</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- ============================================================
			     安装步骤
			     ★ 要改：按实际情况调整
			     ============================================================ -->
			<div class="info-block">
				<h2>使用步骤</h2>
				<ol class="step-list">
					<li>
						<strong>下载</strong>
						<p>点击上方「立即下载」按钮，获取最新版本的安装程序。</p>
					</li>
					<li>
						<strong>安装</strong>
						<p>运行下载好的安装程序，按向导提示完成安装。</p>
					</li>
					<li>
						<strong>运行</strong>
						<p>安装完成后启动程序。</p>
					</li>
					<li>
						<strong>首次使用</strong>
						<p>按照界面提示注册账号后即可使用全部功能。</p>
					</li>
				</ol>

				<p class="text-faint">
					如果你更习惯免安装的方式，<a href="/history">历史版本</a>页里也提供对应版本的免安装压缩包。
				</p>
			</div>

			<!-- ============================================================
			     遇到问题
			     ============================================================ -->
			<div class="info-block">
				<h2>遇到问题</h2>
				<p class="text-muted">
					如果下载或使用过程中遇到问题，请先阅读《使用说明》，
					或通过页脚的邮箱与我们联系。
				</p>
				<p>
					<a class="btn btn-outline btn-sm" href="/changelog">查看更新日志</a>
				</p>
			</div>
		</div>
	</section>

	{/* 依赖补丁弹窗：只有这一页用到，所以不挂进 BaseLayout */}
	<DependencyDialog />
</BaseLayout>

<style>
	/* ---- 顶部标题区（三栏：左入口 / 标题 / 右入口） ---- */
	.download-hero {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		/* 顶部对齐：入口和「下载」这两个字处在同一水平线，而不是跟着副标题往下沉 */
		align-items: start;
		gap: 24px;
		/* 副标题自己带 48px 下边距，这里不用再补 */
	}

	/* 左右两个入口共用一套样式。
	   都比下载卡片轻，避免和中间的「立即下载」抢注意力。 */
	.hero-entry {
		/* h1 有浏览器默认的上边距（约 21px），这里补上让卡片顶部和「下载」平齐 */
		margin-top: 21px;
		display: flex;
		flex-direction: column;
		gap: 3px;
		/* 固定宽度而不是让内容撑开：左右两块要对称，
		   由内容决定的话右边那句长文案会把卡片撑宽，看着一高一低 */
		width: 310px;
		max-width: 100%;
		padding: 13px 16px;
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: 12px;
		color: var(--text);
		text-decoration: none;
		transition: border-color 0.16s, box-shadow 0.16s, transform 0.16s;
	}

	/* 左边贴左、右边贴右，中间那列靠 auto 宽度自己居中 */
	.dep-entry {
		justify-self: start;
	}

	.mirror-entry {
		justify-self: end;
	}

	.hero-entry:hover {
		border-color: var(--brand);
		box-shadow: var(--shadow);
		transform: translateY(-1px);
	}

	.hero-entry:focus-visible {
		outline: 2px solid var(--brand);
		outline-offset: 2px;
	}

	.hero-entry-head {
		display: flex;
		align-items: center;
		gap: 7px;
		font-size: 0.85rem;
		font-weight: 500;
		line-height: 1.45;
	}

	.hero-entry-head svg {
		flex-shrink: 0;
		color: var(--brand);
	}

	.hero-entry-note {
		/* 缩进到文字左边缘：图标 18px + 间距 8px */
		padding-left: 26px;
		font-size: 0.76rem;
		color: var(--text-faint);
	}

	/* 窄屏：三栏收成一列，标题排最上，两个入口依次往下 */
	@media (max-width: 900px) {
		.download-hero {
			grid-template-columns: 1fr;
			gap: 0;
		}

		/* grid 的 order 一样生效，把标题提回最前面 */
		.hero-text {
			order: -1;
		}

		.hero-text .section-subtitle {
			margin-bottom: 26px;
		}

		.hero-entry {
			justify-self: center;
			width: 100%;
			max-width: 340px;
			margin: 0 auto 14px;
			text-align: center;
		}

		/* 最后一个入口和下面的下载卡片之间留出原来的呼吸空间 */
		.mirror-entry {
			margin-bottom: 36px;
		}

		.hero-entry-head {
			justify-content: center;
		}

		.hero-entry-note {
			padding-left: 0;
		}
	}

	.download-card {
		max-width: 720px;
		margin: 0 auto 64px;
		padding: 36px;
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow);
		text-align: center;
	}

	.download-head {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 14px;
		margin-bottom: 16px;
	}

	.download-version {
		font-size: 1.6rem;
		font-weight: 600;
		font-family: var(--font-mono);
	}

	.download-desc {
		color: var(--text-muted);
		margin-bottom: 26px;
	}

	.download-actions {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 12px;
	}

	.download-note {
		margin: 22px 0 0;
	}

	/* ---- 信息区块 ---- */
	.info-block {
		max-width: 720px;
		margin: 0 auto 56px;
	}

	.info-block h2 {
		font-size: 1.3rem;
		padding-bottom: 10px;
		border-bottom: 1px solid var(--border);
	}

	.info-table {
		width: 100%;
		border-collapse: collapse;
	}

	.info-table th,
	.info-table td {
		padding: 12px 0;
		border-bottom: 1px solid var(--border);
		text-align: left;
		vertical-align: top;
	}

	.info-table th {
		width: 130px;
		font-weight: 400;
		color: var(--text-muted);
	}

	.step-list {
		padding-left: 0;
		list-style: none;
		counter-reset: step;
	}

	.step-list li {
		position: relative;
		padding-left: 44px;
		margin-bottom: 26px;
		counter-increment: step;
	}

	/* 用 CSS 计数器画序号圆点，不用手写数字 */
	.step-list li::before {
		content: counter(step);
		position: absolute;
		left: 0;
		top: 2px;
		display: grid;
		place-items: center;
		width: 28px;
		height: 28px;
		border-radius: 50%;
		background: color-mix(in srgb, var(--brand) 12%, transparent);
		color: var(--brand);
		font-size: 0.85rem;
		font-weight: 600;
	}

	.step-list strong {
		display: block;
		margin-bottom: 4px;
	}

	.step-list p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.92rem;
	}

</style>
