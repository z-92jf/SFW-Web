</BaseLayout>

<style>
	.license-card {
		max-width: 760px;
		margin: 0 auto 56px;
		padding: 28px 32px;
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
	}

	.license-table {
		width: 100%;
		border-collapse: collapse;
	}

	.license-table th,
	.license-table td {
		padding: 10px 0;
		border-bottom: 1px solid var(--border);
		text-align: left;
		vertical-align: top;
	}

	.license-table tr:last-child th,
	.license-table tr:last-child td {
		border-bottom: none;
		padding-bottom: 0;
	}

	.license-table th {
		width: 100px;
		font-weight: 400;
		color: var(--text-muted);
	}

	/* 正文按 .prose 排版（定义在全局样式里） */
	.license-body {
		padding-bottom: 8px;
	}

	.license-note {
		color: var(--text-muted);
		font-size: 0.94rem;
	}

	/* 三个等价的声明写法，用列表排开更清楚 */
	.license-variants {
		padding-left: 1.5em;
	}

	.license-variants li {
		font-family: var(--font-mono);
		font-size: 0.88rem;
		color: var(--text-muted);
		margin-bottom: 4px;
	}

	.license-foot {
		max-width: 760px;
		margin: 56px auto 0;
		padding-top: 28px;
		border-top: 1px solid var(--border);
	}

	.license-actions .btn {
		margin-right: 8px;
	}
</style>
