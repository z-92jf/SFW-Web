---
// ============================================================
//  官网首页（路径 /top）
//
//  这是「进入官网」之后看到的第一页。
//  结构从上到下依次是：
//    ① 首屏大图区（产品名 + 下载按钮）
//    ② 核心功能卡片
//    ③ 产品截图
//    ④ 最新更新摘要
//    ⑤ 底部提示条
//
//  ★ 要改内容：几乎都不用改这个文件，
//    改 src/data/site.ts 里的 features / screenshots 即可。
//  ★ 想删掉某一整块（比如暂时没有截图），
//    用 {false && (...)} 包起来，或者直接把那段删掉。
// ============================================================

import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import { site, links, features, screenshots } from '../data/site';
import { getCollection } from 'astro:content';

// 取最新的 3 篇更新日志，用于「最新更新」区块。
// filter 掉 draft: true 的草稿，再按日期从新到旧排序
const recentPosts = (
	await getCollection('changelog', ({ data }) => !data.draft)
)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<BaseLayout title="首页">
	<!-- ============================================================
	     ① 首屏
	     ============================================================ -->
	<section class="hero">
		<div class="container hero-inner">
			<div class="hero-text">
				<div class="hero-badges">
					<span class="badge badge-brand">v{site.version}</span>
					<span class="badge">{site.versionStage}</span>
				</div>

				<h1 class="hero-heading">{site.title}</h1>
				<p class="hero-desc">{site.description}</p>

				<div class="hero-actions">
					<a class="btn btn-primary" href={links.download} target="_blank" rel="noopener">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 3v12M7 11l5 5 5-5M5 21h14" />
						</svg>
						下载最新版
					</a>
					<!-- 站内页面，别加 target="_blank"。历史版本页比 GitHub 快得多 -->
					<a class="btn btn-outline" href="/history">
						查看历史版本
					</a>
				</div>

				<p class="text-faint hero-note">
					适用于 Windows 10 及以上系统 · 最近更新于 {site.releaseDate}
				</p>
			</div>
		</div>
	</section>

	<!-- ============================================================
	     ② 核心功能
	     ★ 要改：卡片内容在 src/data/site.ts 的 features 数组里。
	     ============================================================ -->
	<section class="section">
		<div class="container">
			<h2 class="section-title">核心功能</h2>
			<p class="section-subtitle">一个控制台，收拢日常用得上的几件事。</p>

			<div class="grid">
				{features.map((f) => <FeatureCard icon={f.icon} title={f.title} desc={f.desc} href={f.href} />)}
			</div>
		</div>
	</section>

	<!-- ============================================================
	     ③ 产品截图
	     ★ 要改：截图清单在 src/data/site.ts 的 screenshots 数组里。
	       数组为空时整块自动隐藏（下面这个条件判断做了这件事）。
	     ============================================================ -->
	{
		screenshots.length > 0 && (
			<section class="section section-soft">
				<div class="container">
					<h2 class="section-title">界面预览</h2>
					<p class="section-subtitle">实际运行效果。</p>

					<div class="shot-list">
						{screenshots.map((s) => (
							<figure class="shot">
								<img src={s.src} alt={s.alt} loading="lazy" />
								{s.caption && <figcaption class="text-faint">{s.caption}</figcaption>}
							</figure>
						))}
					</div>
				</div>
			</section>
		)
	}

	<!-- ============================================================
	     ④ 最新更新
	     内容自动来自 src/content/changelog/，不用手改
	     ============================================================ -->
	<section class="section">
		<div class="container">
			<h2 class="section-title">最新更新</h2>
			<p class="section-subtitle">每一次变动都记录在案。</p>

			<div class="post-list">
				{
					recentPosts.map((post) => (
						<a class="post-item" href={`/changelog/${post.id}`}>
							<div class="post-item-head">
								<span class="badge badge-brand">v{post.data.version}</span>
								<time class="text-faint">
									{post.data.pubDate.toLocaleDateString('zh-CN')}
								</time>
							</div>
							<h3 class="post-item-title">{post.data.title}</h3>
							{post.data.summary && <p class="post-item-summary">{post.data.summary}</p>}
						</a>
					))
				}
			</div>

			<p class="text-center mt-4">
				<a class="btn btn-outline btn-sm" href="/changelog">查看全部更新日志</a>
			</p>
		</div>
	</section>

	<!-- ============================================================
	     ⑤ 底部行动区
	     ============================================================ -->
	<section class="section section-soft">
		<div class="container text-center">
			<h2 class="section-title">开始使用</h2>
			<p class="section-subtitle">下载后解压即可运行，无需安装。</p>
			<a class="btn btn-primary btn-lg" href={links.download} target="_blank" rel="noopener">
				下载 v{site.version}
			</a>
		</div>
	</section>
</BaseLayout>

<style>
	/* ---- ① 首屏 ---- */
	.hero {
		padding: 96px 0 80px;
		/* 顶部一层很淡的品牌色渐变，给页面一点层次。
		   不想要这个效果，把这一行删掉即可 */
		background: linear-gradient(
			180deg,
			color-mix(in srgb, var(--brand) 8%, transparent),
			transparent
		);
	}

	.hero-inner {
		display: flex;
		justify-content: center;
	}

	.hero-text {
		max-width: 720px;
		text-align: center;
	}

	.hero-badges {
		display: flex;
		justify-content: center;
		gap: 8px;
		margin-bottom: 20px;
	}

	.hero-heading {
		margin: 0 0 18px;
		font-size: clamp(2rem, 5.5vw, 3.2rem);
		letter-spacing: -0.02em;
	}

	.hero-desc {
		max-width: 620px;
		margin: 0 auto 32px;
		color: var(--text-muted);
		font-size: 1.05rem;
	}

	.hero-actions {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 12px;
	}

	.hero-note {
		margin: 20px 0 0;
	}

	/* ---- ③ 截图 ---- */
	.shot-list {
		display: grid;
		gap: 28px;
	}

	.shot {
		margin: 0;
	}

	.shot img {
		/* 不强制拉伸：图片本身比容器窄时保持原始尺寸，避免小图被放大变糊。
		   推荐提供 1200px 宽的截图，在宽屏上正好铺满 */
		width: auto;
		max-width: 100%;
		margin: 0 auto;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow);
	}

	.shot figcaption {
		margin-top: 10px;
		text-align: center;
	}

	/* ---- ④ 更新列表 ---- */
	.post-list {
		display: grid;
		gap: 16px;
		max-width: 820px;
		margin: 0 auto;
	}

	.post-item {
		display: block;
		padding: 22px 26px;
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		color: inherit;
		text-decoration: none;
		transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
	}

	.post-item:hover {
		border-color: var(--border-strong);
		box-shadow: var(--shadow-lg);
		transform: translateY(-2px);
		text-decoration: none;
	}

	.post-item-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 10px;
	}

	.post-item-title {
		margin: 0 0 6px;
		font-size: 1.08rem;
	}

	.post-item-summary {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.92rem;
	}
</style>
