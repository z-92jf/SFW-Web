---
// ============================================================
//  官网首页（路径 /top）
//
//  这是「进入官网」之后看到的第一页。
//  结构从上到下依次是：
//    ①   首屏（产品名 + 下载按钮）
//    ①-B 数据条（几个关键数字，让页面不显得空）
//    ②   核心功能卡片
//    ③   产品截图
//    ④   最新更新摘要
//    ⑤   常见问题摘要（可展开，链接到 /help）
//    ⑥   三步开始 + 下载按钮
//
//  ★ 要改内容：几乎都不用改这个文件，
//    改 src/data/site.ts 里的 features / screenshots 即可。
//  ★ 想删掉某一整块（比如暂时没有截图），
//    用 {false && (...)} 包起来，或者直接把那段删掉。
// ============================================================

import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import { site, links, features, screenshots } from '../data/site';
import { getCollection } from 'astro:content';

// 取最新的 3 篇更新日志，用于「最新更新」区块。
// filter 掉 draft: true 的草稿，再按日期从新到旧排序
const recentPosts = (
	await getCollection('changelog', ({ data }) => !data.draft)
)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<BaseLayout title="首页">
	<!-- ============================================================
	     ① 首屏
	     ============================================================ -->
	<section class="hero">
		<div class="container hero-inner">
			<div class="hero-text">
				<div class="hero-badges">
					<span class="badge badge-brand">v{site.version}</span>
					<span class="badge">{site.versionStage}</span>
				</div>

				<h1 class="hero-heading">{site.title}</h1>
				<p class="hero-desc">{site.description}</p>

				<div class="hero-actions">
					<a class="btn btn-primary" href={links.download} target="_blank" rel="noopener">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 3v12M7 11l5 5 5-5M5 21h14" />
						</svg>
						下载最新版
					</a>
					<!-- 站内页面，别加 target="_blank"。历史版本页比 GitHub 快得多 -->
					<a class="btn btn-outline" href="/history">
						查看历史版本
					</a>
				</div>

				<p class="text-faint hero-note">
					适用于 Windows 10 及以上系统 · 最近更新于 {site.releaseDate}
				</p>
			</div>
		</div>
	</section>

	<!-- ============================================================
	     ①-B 数据条
	     几个关键数字，让人一眼知道这软件的分量。
	     ★ 要改：数字和说明直接改下面的文字即可。
	     ============================================================ -->
	<section class="stat-bar">
		<div class="container">
			<div class="stat-grid">
				<div class="stat">
					<div class="stat-num">100<span class="stat-unit">+</span></div>
					<div class="stat-label">系统快捷入口</div>
				</div>
				<div class="stat">
					<div class="stat-num">4<span class="stat-unit">大</span></div>
					<div class="stat-label">功能模块</div>
				</div>
				<div class="stat">
					<div class="stat-num">离线</div>
					<div class="stat-label">不联网也能用</div>
				</div>
				<div class="stat">
					<div class="stat-num">免费</div>
					<div class="stat-label">非商业使用</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================================
	     ② 核心功能
	     ★ 要改：卡片内容在 src/data/site.ts 的 features 数组里。
	     ============================================================ -->
	<section class="section">
		<div class="container">
			<h2 class="section-title">核心功能</h2>
			<p class="section-subtitle">一个控制台，收拢日常用得上的几件事。</p>

			<div class="grid">
				{features.map((f) => <FeatureCard icon={f.icon} title={f.title} desc={f.desc} href={f.href} />)}
			</div>
		</div>
	</section>

	<!-- ============================================================
	     ③ 界面预览（轮播）
	     布局参考 Geek Uninstaller 官网的做法：
	     上方是一段跟着滑动的文案，中间一张大图，两侧圆形箭头，下方小圆点。
	     ★ 要改：内容全部在 src/data/site.ts 的 screenshots 数组里，
	       这个文件不用动。数组为空时整块自动隐藏。
	     ============================================================ -->
	{
		screenshots.length > 0 && (
			<section class="section section-soft">
				<div class="container">
					<div class="gallery" id="gallery">
						{/* 上方文案：切图时内容会跟着变，所以标题/描述是从 slide 上取的 */}
						<div class="gallery-head">
							<h2 class="gallery-title" id="galleryTitle">{screenshots[0].title}</h2>
							<p class="gallery-desc" id="galleryDesc">{screenshots[0].desc}</p>
						</div>

						<div class="gallery-stage">
							<button class="gallery-arrow gallery-prev" type="button" aria-label="上一张">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M15 18l-6-6 6-6" />
								</svg>
							</button>

							<div class="gallery-viewport">
								{/* 所有截图排成一横排躺在这条「轨道」里，
								    切换时整条轨道左右平移，把目标那一张推到中间。
								    外层 .gallery-viewport 负责裁剪，所以同一时刻只看得到一张。 */}
								<div class="gallery-track" id="galleryTrack">
									{screenshots.map((s, i) => (
										<figure class="gallery-slide" data-title={s.title} data-desc={s.desc}>
											{/* 第一张不用懒加载，避免刚进页面时中间是空白的 */}
											<img src={s.src} alt={s.alt} loading={i === 0 ? 'eager' : 'lazy'} />
										</figure>
									))}
								</div>
							</div>

							<button class="gallery-arrow gallery-next" type="button" aria-label="下一张">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M9 6l6 6-6 6" />
								</svg>
							</button>
						</div>

						{/* 下方小圆点：一个圆点对应一张图 */}
						<div class="gallery-dots">
							{screenshots.map((s, i) => (
								<button
									class:list={['gallery-dot', { 'is-active': i === 0 }]}
									type="button"
									data-index={i}
									aria-label={`第 ${i + 1} 张：${s.title}`}
								/>
							))}
						</div>
					</div>
				</div>
			</section>
		)
	}

	<!-- ============================================================
	     ④ 最新更新
	     内容自动来自 src/content/changelog/，不用手改
	     ============================================================ -->
	<section class="section">
		<div class="container">
			<h2 class="section-title">最新更新</h2>
			<p class="section-subtitle">每一次变动都记录在案。</p>

			<div class="post-list">
				{
					recentPosts.map((post) => (
						<a class="post-item" href={`/changelog/${post.id}`}>
							<div class="post-item-head">
								<span class="badge badge-brand">v{post.data.version}</span>
								<time class="text-faint">
									{post.data.pubDate.toLocaleDateString('zh-CN')}
								</time>
							</div>
							<h3 class="post-item-title">{post.data.title}</h3>
							{post.data.summary && <p class="post-item-summary">{post.data.summary}</p>}
						</a>
					))
				}
			</div>

			<p class="text-center mt-4">
				<a class="btn btn-outline btn-sm" href="/changelog">查看全部更新日志</a>
			</p>
		</div>
	</section>

	<!-- ============================================================
	     ⑤ 常见问题摘要
	     只放最常被问到的几条，用 <details> 做成可展开的，
	     不需要任何 JS。完整版在 /help 页面。
	     ★ 要改：问题与答案直接改下面的文字。
	     ============================================================ -->
	<section class="section">
		<div class="container">
			<h2 class="section-title">常见问题</h2>
			<p class="section-subtitle">
				更多问题可以查看<a href="/help">完整使用说明</a>。
			</p>

			<div class="faq-list">
				<details class="faq">
					<summary>需要联网才能用吗？</summary>
					<p>不需要。主要功能全部离线可用，只有下载和检查更新时才需要联网。</p>
				</details>

				<details class="faq">
					<summary>账号数据存在哪里？</summary>
					<p>
						保存在程序所在目录，不会上传到任何服务器。
						无论从哪个位置启动程序，读到的都是同一份数据。
					</p>
				</details>

				<details class="faq">
					<summary>为什么下载时杀毒软件会报警？</summary>
					<p>
						新发布的程序被误报比较常见，程序本身不含恶意代码。
						可以先安装，再把安装目录加入杀毒软件的信任列表。
					</p>
				</details>

				<details class="faq">
					<summary>支持哪些 Windows 版本？</summary>
					<p>Windows 10 及以上的 64 位系统，无需额外安装运行库。</p>
				</details>
			</div>
		</div>
	</section>

	<!-- ============================================================
	     ⑥ 三步开始
	     ============================================================ -->
	<section class="section section-soft">
		<div class="container">
			<h2 class="section-title">三步开始</h2>
			<p class="section-subtitle">下载安装程序，按向导提示完成安装即可。</p>

			<div class="start-steps">
				<div class="start-step">
					<div class="start-num">1</div>
					<h3>下载</h3>
					<p>点击下方按钮，获取最新版本的安装程序。</p>
				</div>
				<div class="start-step">
					<div class="start-num">2</div>
					<h3>安装</h3>
					<p>运行安装程序，按向导提示完成安装。</p>
				</div>
				<div class="start-step">
					<div class="start-num">3</div>
					<h3>使用</h3>
					<p>打开程序，注册一个离线账号即可开始。</p>
				</div>
			</div>

			<p class="text-center mt-4">
				<a class="btn btn-primary btn-lg" href={links.download} target="_blank" rel="noopener">
					下载 v{site.version}
				</a>
			</p>
		</div>
	</section>
</BaseLayout>

<script>
	// ============================================================
	// 界面预览轮播
	//
	// 切换方式是「整排横向平移」：所有截图排成一横排躺在 .gallery-track 里，
	// 靠 translateX(-序号 × 100%) 把目标那一张推到中间 ——
	// 所以看起来是新图从箭头那一侧平移进来，而不是旧图淡出、新图淡入。
	//
	// 节奏由下面两个常量控制，想调直接改这里：
	const AUTO_MS = 4000; // 自动播放：每 4 秒翻一张
	const RESUME_MS = 6000; // 用户手动翻过之后，等 6 秒没有新操作再恢复自动播放
	// 第三个规则是「不在视野里就不翻」，见文件末尾的 IntersectionObserver

	const gallery = document.getElementById('gallery');

	if (gallery) {
		const track = document.getElementById('galleryTrack');
		const slides = Array.from(gallery.querySelectorAll('.gallery-slide'));
		const dots = Array.from(gallery.querySelectorAll('.gallery-dot'));
		const titleEl = document.getElementById('galleryTitle');
		const descEl = document.getElementById('galleryDesc');

		// 系统里开了「减少动态效果」的用户：不自动播放（平移动画由 CSS 那边关掉）
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		let current = 0; // 当前是第几张
		let autoTimer = 0; // 自动播放的计时器
		let inView = true; // 轮播是否在可视区域内

		// ---- 切到第 index 张 ----
		function show(index) {
			// 首尾循环：在最后一张按「下一张」回到第一张，反过来也一样
			current = (index + slides.length) % slides.length;

			// 整条轨道往左推 current 个身位（负号 = 往左）。
			// 每张图正好占满一屏，所以「一个身位」就是 100%。
			if (track) track.style.transform = `translateX(-${current * 100}%)`;

			dots.forEach((el, i) => el.classList.toggle('is-active', i === current));

			// 上方的文案从当前这张图的 data-title / data-desc 上取。
			// 用 getAttribute 而不是 dataset，省掉类型断言
			const active = slides[current];
			const nextTitle = active.getAttribute('data-title');
			const nextDesc = active.getAttribute('data-desc');
			if (titleEl && nextTitle) titleEl.textContent = nextTitle;
			if (descEl && nextDesc) descEl.textContent = nextDesc;
		}

		// ---- 自动播放的开关 ----
		function stopAuto() {
			window.clearTimeout(autoTimer);
			autoTimer = 0;
		}

		function startAuto(delay = AUTO_MS) {
			stopAuto();
			// 不在视野里就干脆不排下一个计时器 —— 真正做到「看不见就不动」
			if (reduceMotion || !inView) return;
			autoTimer = window.setTimeout(() => {
				show(current + 1);
				startAuto(AUTO_MS);
			}, delay);
		}

		// 用户自己翻过之后调用。
		// 注意这里传的是 RESUME_MS 而不是 AUTO_MS：
		// startAuto 的语义是「等 delay 毫秒后翻下一张，之后回到每 2 秒一张」，
		// 所以传 5 秒 = 5 秒没有新操作就翻下一张。
		// 用户在这 5 秒里又点了一次，会因为 startAuto 内部先停表而重新计时。
		function userTouched() {
			startAuto(RESUME_MS);
		}

		// ---- 用户操作：箭头 / 小圆点 ----
		gallery.querySelector('.gallery-prev')?.addEventListener('click', () => {
			show(current - 1);
			userTouched();
		});

		gallery.querySelector('.gallery-next')?.addEventListener('click', () => {
			show(current + 1);
			userTouched();
		});

		dots.forEach((dot, i) =>
			dot.addEventListener('click', () => {
				show(i);
				userTouched();
			})
		);

		// 键盘左右键也能翻页（光标在输入框里时不抢按键）
		document.addEventListener('keydown', (event) => {
			const tag = document.activeElement?.tagName;
			if (tag === 'INPUT' || tag === 'TEXTAREA') return;
			if (event.key === 'ArrowLeft') {
				show(current - 1);
				userTouched();
			}
			if (event.key === 'ArrowRight') {
				show(current + 1);
				userTouched();
			}
		});

		// ---- 只在看得见的时候自动播放 ----
		// 轮播滚出屏幕（比如用户滚下去看更新日志了）就停掉，滚回来再继续。
		// 用「露出四分之一」作为判定阈值。
		if ('IntersectionObserver' in window) {
			new IntersectionObserver(
				(entries) => {
					inView = entries[0].isIntersecting;
					if (inView) startAuto(AUTO_MS);
					else stopAuto();
				},
				{ threshold: 0.25 }
			).observe(gallery);
		} else {
			// 极老的浏览器没有这个 API，退化成「一直自动播放」
			startAuto(AUTO_MS);
		}
	}
</script>

<style>
	/* ---- ① 首屏 ---- */
	.hero {
		padding: 96px 0 80px;
		/* 顶部一层很淡的品牌色渐变，给页面一点层次。
		   不想要这个效果，把这一行删掉即可 */
		background: linear-gradient(
			180deg,
			color-mix(in srgb, var(--brand) 8%, transparent),
			transparent
		);
	}

	.hero-inner {
		display: flex;
		justify-content: center;
	}

	.hero-text {
		max-width: 720px;
		text-align: center;
	}

	.hero-badges {
		display: flex;
		justify-content: center;
		gap: 8px;
		margin-bottom: 20px;
	}

	.hero-heading {
		margin: 0 0 18px;
		font-size: clamp(2rem, 5.5vw, 3.2rem);
		letter-spacing: -0.02em;
	}

	.hero-desc {
		max-width: 620px;
		margin: 0 auto 32px;
		color: var(--text-muted);
		font-size: 1.05rem;
	}

	.hero-actions {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 12px;
	}

	.hero-note {
		margin: 20px 0 0;
	}

	/* ---- ①-B 数据条 ---- */
	.stat-bar {
		padding: 34px 0;
		background: var(--bg-soft);
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
	}

	/* auto-fit + minmax：窄屏自动从一行 4 个变成 2 个，不用写媒体查询 */
	.stat-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
		gap: 24px;
		text-align: center;
	}

	.stat-num {
		font-family: var(--font-mono);
		font-size: 1.9rem;
		font-weight: 600;
		line-height: 1.2;
		color: var(--brand);
	}

	.stat-unit {
		font-size: 1rem;
		margin-left: 2px;
	}

	.stat-label {
		margin-top: 4px;
		font-size: 0.9rem;
		color: var(--text-muted);
	}

	/* ---- ⑤ 常见问题 ---- */
	.faq-list {
		display: grid;
		gap: 12px;
		max-width: 820px;
		margin: 0 auto;
	}

	.faq {
		padding: 0 22px;
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		transition: border-color 0.15s;
	}

	.faq:hover {
		border-color: var(--border-strong);
	}

	.faq summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 18px 0;
		font-size: 1rem;
		font-weight: 500;
		cursor: pointer;
		/* 去掉浏览器默认那个小三角，下面换成自己的加号 */
		list-style: none;
	}

	.faq summary::-webkit-details-marker {
		display: none;
	}

	/* 用伪元素画加号／减号，展开状态换符号，不用任何 JS */
	.faq summary::after {
		content: '+';
		flex-shrink: 0;
		font-size: 1.35rem;
		font-weight: 400;
		line-height: 1;
		color: var(--text-faint);
	}

	.faq[open] summary::after {
		content: '−';
	}

	.faq p {
		margin: 0 0 20px;
		font-size: 0.94rem;
		color: var(--text-muted);
	}

	/* ---- ⑥ 三步开始 ---- */
	.start-steps {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
		gap: 24px;
		max-width: 880px;
		margin: 0 auto;
	}

	.start-step {
		padding: 28px 22px;
		text-align: center;
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
	}

	.start-num {
		display: grid;
		place-items: center;
		width: 38px;
		height: 38px;
		margin: 0 auto 16px;
		border-radius: 50%;
		background: color-mix(in srgb, var(--brand) 12%, transparent);
		color: var(--brand);
		font-family: var(--font-mono);
		font-weight: 600;
	}

	.start-step h3 {
		margin: 0 0 6px;
		font-size: 1.05rem;
	}

	.start-step p {
		margin: 0;
		font-size: 0.9rem;
		color: var(--text-muted);
	}

	/* ---- ③ 界面预览轮播 ---- */
	.gallery {
		max-width: 940px;
		margin: 0 auto;
	}

	/* 上方文案。给一个最小高度，免得文案长短不一时页面上下跳动 */
	.gallery-head {
		text-align: center;
		min-height: 92px;
		margin-bottom: 32px;
	}

	.gallery-title {
		margin: 0 0 10px;
		font-size: 1.5rem;
	}

	.gallery-desc {
		max-width: 640px;
		margin: 0 auto;
		font-size: 0.96rem;
		color: var(--text-muted);
	}

	.gallery-stage {
		display: flex;
		align-items: center;
		gap: 18px;
	}

	/* 裁剪窗口：横向平移时，只让中间那一张露出来。
	   注意它本身不能带 transform —— 带 transform 的话，
