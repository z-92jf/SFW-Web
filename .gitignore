# ============================================================
#  Git 忽略清单
#  凡是「可以重新生成」或「体积很大」的东西都不该进仓库。
# ============================================================

# 依赖包：几百 MB，别人 clone 下来执行 npm install 就能装回来
node_modules/

# 构建产物：GitHub Actions 会自动构建，不需要提交
dist/

# Astro 自动生成的类型文件
.astro/

# 各种缓存
.cache/
.npm/

# 编辑器 / 系统生成的杂项文件
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 日志
*.log
npm-debug.log*

# Windows 下 %LOCALAPPDATA% 这类环境变量没被展开时，
# npm 会在当前目录误建一个同名文件夹，这里直接忽略掉
%LOCALAPPDATA%/
%APPDATA%/

# 环境变量文件（里面可能有密钥，绝对不能提交）
.env
.env.production
.env.local
